<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.15">
  <DUT Name="E_AteqHandshakeSteps" Id="{156ee2bd-c863-40c9-9647-6f25eaa354f0}">
    <Declaration><![CDATA[TYPE E_AteqHandshakeSteps :
(
    CMD_IDLE,         	// No command active, ready for new command
    CMD_IN_PROGRESS,  	// ATEQ has acknowledged, command is running
	CMD_WAIT_CYCLE_END,
	CMD_EOC, 			// End Of Cycle
	CMD_DONE,
    CMD_ERROR,        	// Command completed with an error from ATEQ (retries)
    CMD_TIMEOUT,      	// Command did not complete within expected time (retries)
    CMD_RESET,
	CMD_FAIL			// Retires failled, ATEQ comm faulted. 
						// Pass Error To HMI over ProgramAutoSeq: SEQ_ERROR

);
END_TYPE]]></Declaration>
  </DUT>
</TcPlcObject>