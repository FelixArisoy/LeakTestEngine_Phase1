          <data name="http://www.3s-software.com/plcopenxml/method" handleUnknown="implementation">
            <Method name="M_ManualControl" ObjectId="8af14a3c-2dc8-4674-a94b-adeb0c9e665c">
              <interface>
                <returnType>
                  <BOOL />
                </returnType>
                <inputVars>
                  <variable name="ManualTrigValve">
                    <type>
                      <array>
                        <dimension lower="0" upper="31" />
                        <baseType>
                          <BOOL />
                        </baseType>
                      </array>
                    </type>
                  </variable>
                </inputVars>
                <localVars>
                  <variable name="tempMask">
                    <type>
                      <DWORD />
                    </type>
                  </variable>
                  <variable name="ManualOnBit">
                    <type>
                      <DWORD />
                    </type>
                    <initialValue>
                      <simpleValue value="1" />
                    </initialValue>
                  </variable>
                  <variable name="i">
                    <type>
                      <INT />
                    </type>
                  </variable>
                </localVars>
              </interface>
              <body>
                <ST>
                  <xhtml xmlns="http://www.w3.org/1999/xhtml">OutputMask := 0; // reset before loop
FOR i := 0 TO 31 DO
    IF ManualTrigValve[i] THEN
        OutputMask := OutputMask OR SHL(ManualOnBit, i);
    END_IF
END_FOR</xhtml>
                </ST>
              </body>
              <InterfaceAsPlainText>
                <xhtml xmlns="http://www.w3.org/1999/xhtml">METHOD M_ManualControl : BOOL
VAR_INPUT
	ManualTrigValve : ARRAY[0..31] OF BOOL;
END_VAR
VAR
	tempMask : DWORD;
	ManualOnBit	: DWORD := 1;
    i : INT;
END_VAR</xhtml>
              </InterfaceAsPlainText>
              <addData />
            </Method>
          </data>
          <data name="http://www.3s-software.com/plcopenxml/method" handleUnknown="implementation">
            <Method name="M_MapMaskToOutBytes" ObjectId="fe376a1d-db65-4f96-89c4-385f8cf1d130">
              <interface>
                <localVars>
                  <variable name="i">
                    <type>
                      <INT />
                    </type>
                  </variable>
                </localVars>
              </interface>
              <body>
                <ST>
                  <xhtml xmlns="http://www.w3.org/1999/xhtml">OutputMask := nValveMaskInput;

// Reset
FOR i := 0 TO 3 DO
	nValveMaskOutBYTE[i]	:= 0;
	nValveMaskOutSINT[i]	:= 0;
	
	nValveMaskOutWORD[i]	:= 0;
	nValveMaskOutINT[i]		:= 0;
END_FOR
	
	nValveMaskOutDWORD	:= 0;
	nValveMaskOutDINT	:= 0;

CASE nNumOfChannels OF
    8:
        nValveMaskOutBYTE[0] := DWORD_TO_BYTE(OutputMask AND 16#FF);
		nValveMaskOutSINT[0] := DWORD_TO_SINT(OutputMask AND 16#FF);
    16:
        nValveMaskOutBYTE[0] := DWORD_TO_BYTE(OutputMask AND 16#FF);
        nValveMaskOutBYTE[1] := DWORD_TO_BYTE(SHR(OutputMask, 8) AND 16#FF);
		
		nValveMaskOutSINT[0] := DWORD_TO_SINT(OutputMask AND 16#FF);
        nValveMaskOutSINT[1] := DWORD_TO_SINT(SHR(OutputMask, 8) AND 16#FF);
		
		nValveMaskOutWORD[0] := DWORD_TO_WORD(OutputMask AND 16#FFFF);
		nValveMaskOutINT[0]  := DWORD_TO_INT(OutputMask AND 16#FFFF);
    32:
        nValveMaskOutBYTE[0] := DWORD_TO_BYTE(OutputMask AND 16#FF);
        nValveMaskOutBYTE[1] := DWORD_TO_BYTE(SHR(OutputMask, 8) AND 16#FF);
        nValveMaskOutBYTE[2] := DWORD_TO_BYTE(SHR(OutputMask, 16) AND 16#FF);
        nValveMaskOutBYTE[3] := DWORD_TO_BYTE(SHR(OutputMask, 24) AND 16#FF);
		
		nValveMaskOutSINT[0] := DWORD_TO_SINT(OutputMask AND 16#FF);
        nValveMaskOutSINT[1] := DWORD_TO_SINT(SHR(OutputMask, 8) AND 16#FF);
        nValveMaskOutSINT[2] := DWORD_TO_SINT(SHR(OutputMask, 16) AND 16#FF);
        nValveMaskOutSINT[3] := DWORD_TO_SINT(SHR(OutputMask, 24) AND 16#FF);
		
		nValveMaskOutWORD[0] := DWORD_TO_WORD(OutputMask AND 16#FFFF);
		nValveMaskOutWORD[1] := DWORD_TO_WORD(SHR(OutputMask, 16) AND 16#FFFF);
		
		nValveMaskOutINT[0]  := DWORD_TO_INT(OutputMask AND 16#FFFF);
		nValveMaskOutINT[1]  := DWORD_TO_INT(SHR(OutputMask, 16) AND 16#FFFF);
		
		nValveMaskOutDWORD 	:= OutputMask;
		nValveMaskOutDINT	:= DWORD_TO_DINT(OutputMask);
ELSE
    // default safe fallback
    nNumOfChannels := 8;
END_CASE;

</xhtml>
                </ST>
              </body>
              <InterfaceAsPlainText>
                <xhtml xmlns="http://www.w3.org/1999/xhtml">METHOD M_MapMaskToOutBytes
VAR_INPUT
	
END_VAR
VAR
	i : INT;
END_VAR
</xhtml>
              </InterfaceAsPlainText>
              <addData />
            </Method>
          </data>
