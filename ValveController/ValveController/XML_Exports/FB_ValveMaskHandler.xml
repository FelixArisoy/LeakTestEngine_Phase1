    <pous>
      <pou name="FB_ValveMaskHandler" pouType="functionBlock">
        <interface>
          <inputVars>
            <variable name="abValveMaskSetRequest">
              <type>
                <array>
                  <dimension lower="0" upper="(GVL_AteqConfig.nMaxDeviceCount - 1)" />
                  <baseType>
                    <BOOL />
                  </baseType>
                </array>
              </type>
              <documentation>
                <xhtml xmlns="http://www.w3.org/1999/xhtml"> From ATEQ handlers</xhtml>
              </documentation>
            </variable>
            <variable name="aValveMaskSteps">
              <type>
                <array>
                  <dimension lower="0" upper="(GVL_AteqConfig.nMaxTestSteps - 1)" />
                  <baseType>
                    <derived name="ST_ValveMaskStep" />
                  </baseType>
                </array>
              </type>
            </variable>
            <variable name="aAteqValveMaps">
              <type>
                <array>
                  <dimension lower="0" upper="(GVL_AteqConfig.nMaxDeviceCount - 1)" />
                  <baseType>
                    <derived name="ST_AteqValveMap" />
                  </baseType>
                </array>
              </type>
            </variable>
            <variable name="aAteqValveMasks">
              <type>
                <array>
                  <dimension lower="0" upper="(GVL_AteqConfig.nMaxDeviceCount - 1)" />
                  <baseType>
                    <DWORD />
                  </baseType>
                </array>
              </type>
              <documentation>
                <xhtml xmlns="http://www.w3.org/1999/xhtml"> relative masks per ATEQ</xhtml>
              </documentation>
            </variable>
          </inputVars>
          <outputVars>
            <variable name="bValveMaskSetDone">
              <type>
                <BOOL />
              </type>
            </variable>
            <variable name="nCurrentValveMask">
              <type>
                <DWORD />
              </type>
            </variable>
            <variable name="nCurrentStepIndex">
              <type>
                <INT />
              </type>
            </variable>
          </outputVars>
          <localVars>
            <variable name="bStepReady">
              <type>
                <BOOL />
              </type>
            </variable>
            <variable name="tTransitionHold">
              <type>
                <derived name="TON" />
              </type>
            </variable>
            <variable name="eState">
              <type>
                <derived name="Implicit_Enum__FB_ValveMaskHandler__eState" />
              </type>
              <addData>
                <data name="http://www.3s-software.com/plcopenxml/attributes" handleUnknown="implementation">
                  <Attributes>
                    <Attribute Name="implicit_enum_type" Value="" />
                  </Attributes>
                </data>
              </addData>
            </variable>
            <variable name="nPreviousMask">
              <type>
                <DWORD />
              </type>
            </variable>
            <variable name="nIntermediateMask">
              <type>
                <DWORD />
              </type>
            </variable>
            <variable name="i">
              <type>
                <UINT />
              </type>
            </variable>
          </localVars>
          <addData>
            <data name="http://www.3s-software.com/plcopenxml/attributes" handleUnknown="implementation">
              <Attributes>
                <Attribute Name="contains_implicit_enum" />
              </Attributes>
            </data>
          </addData>
        </interface>
        <body>
          <ST>
            <xhtml xmlns="http://www.w3.org/1999/xhtml">
// === Step readiness check ===
bStepReady := TRUE;
FOR i := 0 TO GVL_AteqConfig.nMaxDeviceCount - 1 DO
    IF (aValveMaskSteps[nCurrentStepIndex].nExpectedDoneMask AND SHL(1, i)) &lt;&gt; 0 THEN
        IF NOT abValveMaskSetRequest[i] THEN
            bStepReady := FALSE;
            EXIT;
        END_IF
    END_IF
END_FOR

CASE eState OF

    IDLE:
        IF bStepReady THEN
            nPreviousMask := nCurrentValveMask;
            nIntermediateMask := 0;
            
            CASE aValveMaskSteps[nCurrentStepIndex].eTransitionMode OF

                HoldPrevious_ON:
                    nIntermediateMask := nPreviousMask OR M_ComposeValveBankMask(aAteqValveMaps, aAteqValveMasks);
                    nCurrentValveMask := nIntermediateMask;
                    eState := TRANSITION_HOLD;
                    tTransitionHold(IN := TRUE, PT := aValveMaskSteps[nCurrentStepIndex].tTransitionHoldTime);

                HoldNext_OFF:
                    nIntermediateMask := nPreviousMask AND NOT M_ComposeValveBankMask(aAteqValveMaps, aAteqValveMasks);
                    nCurrentValveMask := nIntermediateMask;
                    eState := TRANSITION_HOLD;
                    tTransitionHold(IN := TRUE, PT := aValveMaskSteps[nCurrentStepIndex].tTransitionHoldTime);

                Immediate:
                    nCurrentValveMask := M_ComposeValveBankMask(aAteqValveMaps, aAteqValveMasks);
                    bValveMaskSetDone := TRUE;
                    nCurrentStepIndex := nCurrentStepIndex + 1;
            END_CASE
        END_IF

    TRANSITION_HOLD:
        tTransitionHold(IN := TRUE);
        IF tTransitionHold.Q THEN
            eState := APPLY_FINAL;
            tTransitionHold(IN := FALSE);
        END_IF

    APPLY_FINAL:
        nCurrentValveMask := M_ComposeValveBankMask(aAteqValveMaps, aAteqValveMasks);
        bValveMaskSetDone := TRUE;
        nCurrentStepIndex := nCurrentStepIndex + 1;
        eState := IDLE;
END_CASE
</xhtml>
          </ST>
        </body>
        <addData>
          <data name="http://www.3s-software.com/plcopenxml/method" handleUnknown="implementation">
            <Method name="M_ComposeValveBankMask" ObjectId="02ff877c-ba6f-43fd-98c2-2957bc2319d2">
              <interface>
                <returnType>
                  <DWORD />
                </returnType>
                <inputVars>
                  <variable name="aValveMaps">
                    <type>
                      <array>
                        <dimension lower="0" upper="(GVL_AteqConfig.nMaxDeviceCount - 1)" />
                        <baseType>
                          <derived name="ST_AteqValveMap" />
                        </baseType>
                      </array>
                    </type>
                  </variable>
                  <variable name="aMasks">
                    <type>
                      <array>
                        <dimension lower="0" upper="(GVL_AteqConfig.nMaxDeviceCount - 1)" />
                        <baseType>
                          <DWORD />
                        </baseType>
                      </array>
                    </type>
                  </variable>
                </inputVars>
                <localVars>
                  <variable name="result">
                    <type>
                      <DWORD />
                    </type>
                    <initialValue>
                      <simpleValue value="0" />
                    </initialValue>
                  </variable>
                  <variable name="i">
                    <type>
                      <INT />
                    </type>
                  </variable>
                </localVars>
                <addData>
                  <data name="http://www.3s-software.com/plcopenxml/accessmodifiers" handleUnknown="implementation">
                    <AccessModifiers Private="true" />
                  </data>
                </addData>
              </interface>
              <body>
                <ST>
                  <xhtml xmlns="http://www.w3.org/1999/xhtml">FOR i := 0 TO GVL_AteqConfig.nMaxDeviceCount - 1 DO
    result := result OR SHL(aMasks[i], aValveMaps[i].nValveStartIndex);
END_FOR
M_ComposeValveBankMask := result;
</xhtml>
                </ST>
              </body>
              <InterfaceAsPlainText>
                <xhtml xmlns="http://www.w3.org/1999/xhtml">METHOD PRIVATE M_ComposeValveBankMask : DWORD
VAR_INPUT
    aValveMaps : ARRAY[0..GVL_AteqConfig.nMaxDeviceCount - 1] OF ST_AteqValveMap;
    aMasks : ARRAY[0..GVL_AteqConfig.nMaxDeviceCount - 1] OF DWORD;
END_VAR
VAR
    result : DWORD := 0;
    i : INT;
END_VAR</xhtml>
              </InterfaceAsPlainText>
              <addData />
            </Method>
          </data>
          <data name="http://www.3s-software.com/plcopenxml/interfaceasplaintext" handleUnknown="implementation">
            <InterfaceAsPlainText>
              <xhtml xmlns="http://www.w3.org/1999/xhtml">FUNCTION_BLOCK FB_ValveMaskHandler
VAR_INPUT
    abValveMaskSetRequest : ARRAY[0..GVL_AteqConfig.nMaxDeviceCount - 1] OF BOOL; // From ATEQ handlers
    aValveMaskSteps : ARRAY[0..GVL_AteqConfig.nMaxTestSteps - 1] OF ST_ValveMaskStep;
    aAteqValveMaps : ARRAY[0..GVL_AteqConfig.nMaxDeviceCount - 1] OF ST_AteqValveMap;
    aAteqValveMasks : ARRAY[0..GVL_AteqConfig.nMaxDeviceCount - 1] OF DWORD; // relative masks per ATEQ
END_VAR

VAR_OUTPUT
    bValveMaskSetDone : BOOL;
    nCurrentValveMask : DWORD;
    nCurrentStepIndex : INT;
END_VAR

VAR
    bStepReady : BOOL;
    tTransitionHold : TON;
    eState : (IDLE, TRANSITION_HOLD, APPLY_FINAL);
    nPreviousMask : DWORD;
    nIntermediateMask : DWORD;
	i : UINT;
END_VAR</xhtml>
