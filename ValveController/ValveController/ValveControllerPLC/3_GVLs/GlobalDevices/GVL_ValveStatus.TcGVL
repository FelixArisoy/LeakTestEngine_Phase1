<TcPlcObject Version="1.1.0.1">
  <GVL Name="GVL_ValveStatus" Id="{59ad9f5b-4d90-436d-b338-fc83937e29c2}">
    <Declaration><![CDATA[VAR_GLOBAL CONSTANT
	// Status values depend on hardware config.
    OPENED         	: DWORD := 16#0001;
    CLOSED         	: DWORD := 16#0002;
    SHORT_CIRCUIT   : DWORD := 16#0010;
    OPEN_CIRCUIT    : DWORD := 16#0020;
    STATUS_FAULT_OVERRIDE : DWORD := 16#0040;
END_VAR]]></Declaration>
  </GVL>
</TcPlcObject>