      <LineId Id="1313" Count="6" />
      <LineId Id="1515" Count="1" />
      <LineId Id="1320" Count="0" />
      <LineId Id="1518" Count="2" />
      <LineId Id="1517" Count="0" />
      <LineId Id="1321" Count="149" />
      <LineId Id="1485" Count="6" />
      <LineId Id="1477" Count="7" />
      <LineId Id="5" Count="0" />
    </LineIds>
    <LineIds Name="FB_AteqComm.M_OutputMap">
      <LineId Id="567" Count="65" />
      <LineId Id="660" Count="0" />
      <LineId Id="633" Count="0" />
      <LineId Id="661" Count="0" />
      <LineId Id="679" Count="0" />
      <LineId Id="665" Count="1" />
      <LineId Id="668" Count="1" />
      <LineId Id="663" Count="0" />
      <LineId Id="670" Count="1" />
      <LineId Id="673" Count="2" />
      <LineId Id="677" Count="1" />
      <LineId Id="672" Count="0" />
      <LineId Id="662" Count="0" />
      <LineId Id="640" Count="10" />
      <LineId Id="5" Count="0" />
    </LineIds>
  </POU>
