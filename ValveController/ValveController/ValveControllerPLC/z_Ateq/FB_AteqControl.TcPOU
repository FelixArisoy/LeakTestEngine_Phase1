    <Method Name="M_ProgramSelect" Id="{3f180883-986e-4f1d-b18a-91a389fa3ca6}">
      <Declaration><![CDATA[METHOD M_ProgramSelect : WORD
VAR
	bComplete 	: BOOL;
	bFaulted	: BOOL;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[
stMappedIo.stWrite.nProgramSelect := M_ProgramSelect;

	IF stMappedIo.stWrite.nProgramSelect >= 0 THEN
		stMappedIo.stWrite.stCommands.bProgramSelect := TRUE;
	END_IF

	IF stMappedIo.stRead.anErrorCode[0] = 16#FF AND stMappedIo.stRead.anErrorCode[1] = 16#FF THEN // Command in Progress
	

		IF stMappedIo.stRead.stEcho.bProgramSelect = TRUE AND stMappedIo.stRead.anErrorCode[0] = 0 AND stMappedIo.stRead.anErrorCode[1] = 0 THEN //Command is correctly carried out.
			
		IF stMappedIo.stRead.nProgramInUse = stMappedIo.stWrite.nProgramSelect THEN
			
			stMappedIo.stWrite.stCommands.bProgramSelect := FALSE;
			stMappedIo.stWrite.nProgramSelect := 0;
			bComplete := TRUE;
			
		END_IF
		END_IF
		
	ELSIF stMappedIo.stRead.stErrorCode.bProgramSelect = TRUE THEN
		
		stMappedIo.stWrite.stCommands.bProgramSelect := FALSE;
		bFaulted := TRUE;

	END_IF]]></ST>
      </Implementation>
    </Method>
