    <Method Name="M_SpecialCycle" Id="{d187d757-2cbf-4176-839b-3ef7d7928184}">
      <Declaration><![CDATA[METHOD M_SpecialCycle : E_CommandStatus
VAR

END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[
stMappedIo.stWrite.nSpecialCycle 				:= nSpecialCycleId;

	
	M_SpecialCycle := M_CommandHandler	(	bCmd 		:= stMappedIo.stWrite.stCommands.bSpecialCycle,
											bCmdEcho	:= stMappedIo.stRead.stEcho.bSpecialCycle,
											bCmdError	:= stMappedIo.stRead.stErrorCode.bSpecialCycle
										);

	


]]></ST>
      </Implementation>
    </Method>
    <Method Name="M_zSequence" Id="{470ae35c-cda6-49a5-a2ba-29d25da98e8a}">
      <Declaration><![CDATA[METHOD M_zSequence : BOOL
VAR
	    eSeqState   : E_AteqSequence;
		eCmdStatus	: E_CommandStatus;
		
		tStepDelay 	: TON;
    	bWait      	: BOOL;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[eSeqState := AUTO_ZERO;

	CASE eSeqState OF
		
    IDLE: // waiting trigger
		IF stMappedIo.stRead.stRealtimeTestResults.bCycleEnd THEN
			//stMappedIo.stWrite.stCommands.bStart := TRUE;
            //stMappedIo.stWrite.stCommands.bReset := FALSE;
			eSeqState := RESET_FIFO;
		END_IF
	PROGRAM_SELECT:
		// Optional if not manually selected
	RESET_FIFO:
		// Must Reset before Running Programs for good functioning
		
	AUTO_ZERO:
    	nSpecialCycleId := GVL_AteqSpecialCycle.PiezoAutoZeroReg2;
    	stMappedIo.stWrite.stCommands.bStart := TRUE;
		stMappedIo.stWrite.stCommands.bSpecialCycle		:= TRUE;

    	eCmdStatus := M_SpecialCycle(); // Call method and get Cmd Status result

    CASE eCmdStatus OF
        CMD_ERROR:
            stMappedIo.stWrite.stCommands.bStart := FALSE;
            stMappedIo.stWrite.stCommands.bReset := TRUE;
            eSeqState := AUTO_ZERO; // retry
        CMD_DONE:
            stMappedIo.stWrite.stCommands.bStart := FALSE;
            stMappedIo.stWrite.stCommands.bReset := FALSE;
			stMappedIo.stWrite.stCommands.bSpecialCycle		:= FALSE;
            
            bWait := TRUE;
            tStepDelay(IN := bWait, PT := T#10S); // adjust delay time as needed

            IF tStepDelay.Q THEN
                bWait := FALSE;
                eSeqState := START_CYCLE;
            END_IF
    END_CASE
		
	START_CYCLE: // Program start
        stMappedIo.stWrite.stCommands.bStart := TRUE;
		eCmdStatus 	:= M_ProgramStart();
		
	CASE eCmdStatus OF
        CMD_ERROR:
            stMappedIo.stWrite.stCommands.bStart := FALSE;
            stMappedIo.stWrite.stCommands.bReset := TRUE;
            eSeqState := START_CYCLE; // retry
        CMD_DONE:
            stMappedIo.stWrite.stCommands.bStart := FALSE;
            stMappedIo.stWrite.stCommands.bReset := FALSE;
            
            bWait := TRUE;
            tStepDelay(IN := bWait, PT := T#10S); // adjust delay time as needed

            IF tStepDelay.Q THEN
                bWait := FALSE;
                eSeqState 	:= LIVE_READING;
            END_IF
    END_CASE
        
		
	LIVE_READING: // Monitor live values
		
		IF stMappedIo.stRead.stRealtimeTestResults.bCycleEnd THEN
			stMappedIo.stWrite.stCommands.bStart := FALSE;
            stMappedIo.stWrite.stCommands.bReset := FALSE;
			eSeqState := END_OF_CYCLE;
		END_IF
		
    END_OF_CYCLE: // Wait End Of Cycle = 1
	
	TIME_STAMP: // Test Time stamp
	
    READ_LAST_RESULT: // read last result
	
	READ_FIFO: // Not used for now
	
    DONE: // wait reset
       
		
    END_CASE
	
]]></ST>
      </Implementation>
    </Method>
    <Property Name="P_SystemDateTime" Id="{edbff775-b379-4408-8922-353bd74d8226}">
      <Declaration><![CDATA[PROPERTY P_SystemDateTime : DT]]></Declaration>
      <Get Name="Get" Id="{e8fbd260-46bb-4198-bba6-59c4a737ee81}">
        <Declaration><![CDATA[VAR

END_VAR
]]></Declaration>
        <Implementation>
          <ST><![CDATA[P_SystemDateTime := ULINT_TO_DT(GVL_System.nTime);
]]></ST>
        </Implementation>
      </Get>
    </Property>
