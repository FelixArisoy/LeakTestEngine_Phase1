    <Method Name="M_Sequence" Id="{470ae35c-cda6-49a5-a2ba-29d25da98e8a}">
      <Declaration><![CDATA[METHOD M_Sequence : BOOL
VAR
	    eSeqState   : E_AteqSequence;
		eCmdStatus	: E_CommandStatus;
		
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[    (*

	CASE eSeqState OF
		
    IDLE:
        // waiting trigger
	PROGRAM_SELECT:
		// Optional if not manually selected
	RESET_FIFO:
		// Must Reset before Running Programs for good functioning
		
	AUTO_ZERO:*)	// auto-zero special cycle
	nSpecialCycleId := GVL_AteqSpecialCycle.PiezoAutoZeroReg2; // identifier for special cycle Auto Zero
	eCmdStatus := M_SpecialCycle();  // Call method and get Cmd Status result

		IF eCmdStatus = CMD_ERROR THEN
			stMappedIo.stWrite.stCommands.bReset := TRUE;
			// Optionally: Retry or go to error handling state
			eSeqState := AUTO_ZERO; // retry

		ELSIF eCmdStatus = CMD_DONE THEN
			eSeqState := START_CYCLE;
		END_IF
		;
(*		
	START_CYCLE:
        // punch start
            
        eSeqState := LIVE_READING;
		
	LIVE_READING: // Live values
	
    END_OF_CYCLE: // Wait End Of Cycle = 1
	
	TIME_STAMP: // Test Time stamp
	
    READ_LAST_RESULT: // read last result
	
	READ_FIFO: // Not used for now
	
    DONE: // wait reset
        IF NOT bTriggerTest THEN
            eSeqState := END_OF_CYCLE;
            bTestFinished := FALSE;
        END_IF
		
    END_CASE
	
	*)]]></ST>
      </Implementation>
    </Method>
    <Method Name="M_SpecialCycle" Id="{d187d757-2cbf-4176-839b-3ef7d7928184}">
      <Declaration><![CDATA[METHOD M_SpecialCycle : E_CommandStatus
VAR

END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[
stMappedIo.stWrite.nSpecialCycle 				:= nSpecialCycleId;
stMappedIo.stWrite.stCommands.bSpecialCycle 	:= TRUE;
stMappedIo.stWrite.stCommands.bStart 			:= TRUE;


	
	M_SpecialCycle := M_CommandHandler	(	bCmd 		:= stMappedIo.stWrite.stCommands.bSpecialCycle,
						bCmdStart 	:= stMappedIo.stWrite.stCommands.bStart,
						bCmdEcho	:= stMappedIo.stRead.stEcho.bSpecialCycle,
						bCmdError	:= stMappedIo.stRead.stErrorCode.bSpecialCycle
					);

	


]]></ST>
      </Implementation>
    </Method>
