<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.15">
  <POU Name="FB_AteqControl" Id="{7f132da6-4770-42a7-a01e-2190c92a7cb5}" SpecialFunc="None">
    <Declaration><![CDATA[FUNCTION_BLOCK FB_AteqControl IMPLEMENTS I_LeakTester
VAR_INPUT
   bRunAutoTestSequence 	: BOOL;         // Rising edge to start an automatic test sequence
   nProgramNumber 			: WORD; // Input for the program number to select
   
END_VAR
VAR_IN_OUT
    stIo   	: ST_AteqMappedIo; 
    //Mapped Io Exchange zone will be passing the data to ResultRaw Struct then FB will decode it to ResultDecoded Struct. 
    //Properties will pass the decoded data to outside of the FB
END_VAR
VAR_OUTPUT
   bAutoTestSequenceDone : BOOL := TRUE; // Indicates completion of the auto sequence
   abDebug             : ARRAY[0..9] OF BOOL;
   abDebug1             : ARRAY[0..9] OF BOOL;
   nCounter				: DINT;
END_VAR
VAR
	// Internal variables for FB_AteqControl
	
	stResultsRaw		: ST_AteqResultsRaw;
	stLastResults		: ST_AteqResultsDecoded;
    astFIFO				: ARRAY[0..7] OF ST_AteqResultsDecoded;

    // State variable for the automatic test sequence
    eAutoSequenceState 	: E_AutoTestState := E_AutoTestState.IDLE; // Initialize to IDLE

    // Internal timers/flags for sequence management
    tStepDelay : TON; // Timer for various step delays/timeouts
    tAbortDelay : TON; 
    bWait 				: BOOL;
    
    // Debug flags
   
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[// Main call for the automatic test sequence
M_AutoTestSequence();
// You can add other monitoring or manual command calls here if needed,
// but the sequence method should be the primary driver.]]></ST>
    </Implementation>
    <Method Name="FB_init" Id="{f90f68ec-27ab-45f4-bcaf-6d232744dbd4}">
      <Declaration><![CDATA[METHOD FB_init : BOOL
VAR_INPUT
	bInitRetains : BOOL; // if TRUE, the retain variables are initialized (warm start / cold start)
	bInCopyCode : BOOL;  // if TRUE, the instance afterwards gets moved into the copy code (online change)
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[// Initialize internal state variables to a known default state
eAutoSequenceState := E_AutoTestState.IDLE;
bAutoTestSequenceDone := TRUE;
bWait := FALSE;
tStepDelay(IN := FALSE); // Ensure timer is off initially]]></ST>
      </Implementation>
    </Method>
    <Method Name="M_AutoTestSequence" Id="{470ae35c-cda6-49a5-a2ba-29d25da98e8a}">
      <Declaration><![CDATA[METHOD M_AutoTestSequence
VAR
    eCmdStatusLocal : E_CommandStatus; // Local variable to hold command status
	fbR_TRIG_RunSequence : R_TRIG;
	i : INT;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[// Detect rising edge of bRunAutoTestSequence to initiate the sequence
fbR_TRIG_RunSequence(CLK := bRunAutoTestSequence);

// Control the start of the sequence
IF fbR_TRIG_RunSequence.Q AND eAutoSequenceState = E_AutoTestState.IDLE THEN
    bAutoTestSequenceDone := FALSE; // Reset done flag
    eAutoSequenceState := E_AutoTestState.WAIT_READY; // Start the sequence
END_IF

// Abort logic: If bRunAutoTestSequence goes FALSE while sequence is running
// (and not already in an IDLE/DONE state), reset to IDLE after a short delay.
IF NOT bRunAutoTestSequence AND eAutoSequenceState <> E_AutoTestState.IDLE AND eAutoSequenceState <> E_AutoTestState.TEST_DONE AND eAutoSequenceState <> E_AutoTestState.ERROR_SEQUENCE THEN
    eAutoSequenceState := E_AutoTestState.ABORTING; // Go to an aborting state
    tAbortDelay(IN := TRUE, PT := T#500MS); // Give some time for commands to settle
END_IF

// Always call the timers
tStepDelay(IN := tStepDelay.IN, PT := tStepDelay.PT); // Keep timer running based on its IN status
tAbortDelay(IN := tAbortDelay.IN, PT := tAbortDelay.PT);

CASE eAutoSequenceState OF
    E_AutoTestState.IDLE:
        // Waiting for bRunAutoTestSequence to go TRUE
        // All debugs should be FALSE here if starting clean
        FOR i := 0 TO 9 DO abDebug[i] := FALSE; END_FOR;
        bAutoTestSequenceDone := FALSE; // Ensure done flag is off

    E_AutoTestState.ABORTING: // New state for clean abortion
        // Wait for the abort delay to complete
        IF tAbortDelay.Q THEN
            eAutoSequenceState := E_AutoTestState.IDLE; // Finally return to IDLE
            tAbortDelay(IN := FALSE); // Reset abort timer
            // Optionally, add logic here to forcefully stop any running ATEQ command if possible
            // e.g., stIo.stWrite.stCommands.bStopTest := TRUE; // for a scan
        END_IF;

    E_AutoTestState.WAIT_READY: // Wait until ATEQ is ready (e.g., CycleEnd is TRUE)
        // Start timeout for this step if not already running
        IF NOT tStepDelay.IN THEN
            tStepDelay(IN := TRUE, PT := T#30S); // Max wait time for ready
        END_IF

        IF stIo.stRead.stRealtimeTestResults.bCycleEnd THEN // ATEQ indicates it's finished its last cycle
            eAutoSequenceState := E_AutoTestState.RESET_FIFO;
            tStepDelay(IN := FALSE); // Reset timer upon successful transition
            abDebug[0] := TRUE;
        ELSIF tStepDelay.Q THEN // Timeout if ATEQ never becomes ready
            eAutoSequenceState := E_AutoTestState.ERROR_SEQUENCE;
            tStepDelay(IN := FALSE); // Reset timer on error transition
            abDebug[9] := TRUE;
        END_IF;

    E_AutoTestState.RESET_FIFO: // Clear FIFO
        eCmdStatusLocal := M_ResetFIFO(); // Call the M_ResetFIFO method, which internally calls fbCmdHandler
        abDebug[1] := TRUE;

        IF eCmdStatusLocal = E_CommandStatus.CMD_IDLE THEN
            stIo.stWrite.stCommands.bResetFIFO := TRUE; // SET THE TRIGGER HIGH for one scan
        END_IF
        	
		(*	IF stIo.stRead.nResultsInFifo = 0 THEN
				stIo.stWrite.stCommands.bResetFIFO := FALSE; 
				eAutoSequenceState := E_AutoTestState.AUTO_ZERO;
			END_IF*)
        CASE eCmdStatusLocal OF
            E_CommandStatus.CMD_DONE:
                // FB_CommandHandler has managed stIo.stWrite.stCommands.bResetFIFO := FALSE and handled its internal delay.
                eAutoSequenceState := E_AutoTestState.AUTO_ZERO;
                tStepDelay(IN := FALSE); // Ensure tStepDelay is off before next state (if used for other purposes)
            
            E_CommandStatus.CMD_ERROR, E_CommandStatus.CMD_TIMEOUT:
                eAutoSequenceState := E_AutoTestState.ERROR_SEQUENCE;
                abDebug[2] := TRUE;
        END_CASE;

    E_AutoTestState.AUTO_ZERO: // Perform Auto Zero (Special Cycle ID 16#08 for Piezo Auto Zero Reg 2)
        eCmdStatusLocal := M_SpecialCycle(nSpecialCycleId := GVL_AteqSpecialCycle.PiezoAutoZeroReg2);
        abDebug[3] := TRUE;

        // **Corrected: This provides the rising edge trigger for M_SpecialCycle**
        IF eCmdStatusLocal = E_CommandStatus.CMD_IDLE THEN
            stIo.stWrite.stCommands.bSpecialCycle := TRUE; // SET THE TRIGGER HIGH for one scan
        END_IF

        CASE eCmdStatusLocal OF
            E_CommandStatus.CMD_DONE:
                // Command is done, now wait for ATEQ internal stabilization
                IF NOT tStepDelay.IN THEN // Start the delay only if not already running
                    tStepDelay(IN := TRUE, PT := T#10S); // Example: ATEQ internal stabilization delay
                END_IF

                IF tStepDelay.Q THEN // Delay time has elapsed
                    eAutoSequenceState := E_AutoTestState.PROGRAM_SELECT;
                    tStepDelay(IN := FALSE); // Reset timer for next use
                END_IF
            
            E_CommandStatus.CMD_ERROR, E_CommandStatus.CMD_TIMEOUT:
                eAutoSequenceState := E_AutoTestState.ERROR_SEQUENCE;
                abDebug[4] := TRUE;
                tStepDelay(IN := FALSE); // Reset timer on error
        END_CASE;

    E_AutoTestState.PROGRAM_SELECT: // Select the test program (assuming Program 1 for example)
        eCmdStatusLocal := M_ProgramSelect(); // This method might take a program number as input
        abDebug[5] := TRUE;

        // **Corrected: This provides the rising edge trigger for M_ProgramSelect**
        IF eCmdStatusLocal = E_CommandStatus.CMD_IDLE THEN
            stIo.stWrite.stCommands.bProgramSelect := TRUE; // SET THE TRIGGER HIGH for one scan
        END_IF

        CASE eCmdStatusLocal OF
            E_CommandStatus.CMD_DONE:
                eAutoSequenceState := E_AutoTestState.START_PROGRAM;
                tStepDelay(IN := FALSE); // Ensure tStepDelay is off
            
            E_CommandStatus.CMD_ERROR, E_CommandStatus.CMD_TIMEOUT:
                eAutoSequenceState := E_AutoTestState.ERROR_SEQUENCE;
                abDebug[6] := TRUE;
        END_CASE;

    E_AutoTestState.START_PROGRAM: // Start the test program
        eCmdStatusLocal := M_ProgramStart();
        abDebug[7] := TRUE;

        // **Corrected: This provides the rising edge trigger for M_ProgramStart**
        IF eCmdStatusLocal = E_CommandStatus.CMD_IDLE THEN
            stIo.stWrite.stCommands.bStart := TRUE; // SET THE TRIGGER HIGH for one scan
        END_IF

        CASE eCmdStatusLocal OF
            E_CommandStatus.CMD_DONE:
                eAutoSequenceState := E_AutoTestState.WAIT_COMPLETION;
                tStepDelay(IN := FALSE); // Reset timer before starting wait for completion
            
            E_CommandStatus.CMD_ERROR, E_CommandStatus.CMD_TIMEOUT:
                eAutoSequenceState := E_AutoTestState.ERROR_SEQUENCE;
                abDebug[8] := TRUE;
        END_CASE;

    E_AutoTestState.WAIT_COMPLETION: // Wait for program completion (ATEQ signals via bCycleEnd)
        // Start timeout for this step if not already running
        IF NOT tStepDelay.IN THEN
            tStepDelay(IN := TRUE, PT := T#60S); // Max test duration
        END_IF
        
        IF stIo.stRead.stRealtimeTestResults.bCycleEnd THEN
            eAutoSequenceState := E_AutoTestState.READ_LAST_RESULT;
            tStepDelay(IN := FALSE); // Reset timer upon successful completion
        ELSIF tStepDelay.Q THEN // Timeout waiting for cycle end
            eAutoSequenceState := E_AutoTestState.ERROR_SEQUENCE;
            tStepDelay(IN := FALSE); // Reset timer on error transition
        END_IF;
        
    E_AutoTestState.READ_LAST_RESULT: // Retrieve and store test results
        eCmdStatusLocal := M_ReadLastResult(); // This method should handle writing to stLastResults
        
        // **Corrected: This provides the rising edge trigger for M_ReadLastResult**
        IF eCmdStatusLocal = E_CommandStatus.CMD_IDLE THEN
            stIo.stWrite.stCommands.bReadLastResult := TRUE; // SET THE TRIGGER HIGH for one scan
        END_IF

        CASE eCmdStatusLocal OF
            E_CommandStatus.CMD_DONE:
                // stLastResults is now updated by M_ReadLastResult (ensure this logic is inside M_ReadLastResult or its FB)
                eAutoSequenceState := E_AutoTestState.TEST_DONE;
                tStepDelay(IN := FALSE); // Ensure timer is off
            
            E_CommandStatus.CMD_ERROR, E_CommandStatus.CMD_TIMEOUT:
                eAutoSequenceState := E_AutoTestState.ERROR_SEQUENCE;
        END_CASE;

    E_AutoTestState.TEST_DONE: // Sequence completed successfully
        bAutoTestSequenceDone := TRUE; // Set output flag
        eAutoSequenceState := E_AutoTestState.IDLE; // Go back to IDLE, waiting for next trigger
        // All timers should already be off when entering IDLE.

    E_AutoTestState.ERROR_SEQUENCE: // Handle errors in the sequence
        // You can add more detailed error handling here (e.g., specific error codes, logging)
        bAutoTestSequenceDone := FALSE; // Indicate failure
        // Ensure all timers are reset on error
        tStepDelay(IN := FALSE);
        tAbortDelay(IN := FALSE); // If for some reason an abort was active when error occurred

        // Allow resetting the error state by turning off bRunAutoTestSequence externally
        IF NOT bRunAutoTestSequence THEN
            eAutoSequenceState := E_AutoTestState.IDLE; // Go back to IDLE
        END_IF
END_CASE]]></ST>
      </Implementation>
    </Method>
    <Method Name="M_ParamRead" Id="{e5267fc8-c940-466e-9918-6092a897a7f1}">
      <Declaration><![CDATA[METHOD M_ParamRead : E_CommandStatus
VAR
   fbCmdHandler : FB_AteqCmdHandler;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[]]></ST>
      </Implementation>
    </Method>
    <Method Name="M_ParamWrite" Id="{efef9bf2-d12a-4715-8734-c95ea8380a79}">
      <Declaration><![CDATA[METHOD M_ParamWrite : E_CommandStatus
VAR
