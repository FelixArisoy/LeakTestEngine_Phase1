  <POU Name="FB_AteqControl" Id="{7f132da6-4770-42a7-a01e-2190c92a7cb5}" SpecialFunc="None">
    <Declaration><![CDATA[FUNCTION_BLOCK FB_AteqControl IMPLEMENTS I_LeakTester
VAR_INPUT
   //TriggerTest 	: BOOL;         // Rising edge to start a test
END_VAR
VAR_IN_OUT
    stMappedIo   	: ST_AteqMappedIo; 
//Mapped Io Exchange zone will be passing the data to ResultRaw Struct then FB will decode it to ResultDecoded Struct. 
//Properties will pass the decoded data to outside of the FB
END_VAR
VAR_OUTPUT
   //TestFinished 	: BOOL;
END_VAR
VAR
	
	nSpecialCycleId		: WORD; //  AutoZero h08
	stResultsRaw		: ST_AteqResultsRaw;
	stLastResults		: ST_AteqResultsDecoded;
    astFIFO				: ARRAY[0..7] OF ST_AteqResultsDecoded;
	
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[
M_zSequence();
]]></ST>
    </Implementation>
    <Method Name="M_CommandHandler" Id="{56a501ea-a269-47d7-a142-013486e4bf60}">
      <Declaration><![CDATA[METHOD PRIVATE M_CommandHandler : E_CommandStatus
VAR_IN_OUT
	bCmd			: BOOL; // Cmd Tobe started from ST_Commands
    
END_VAR
VAR_INPUT   
    bCmdEcho        : BOOL; // Command echo bit from ATEQ
    bCmdError       : BOOL; // Error code bit from ATEQ
END_VAR

VAR
	tTimeout        : TIME := GVL_Ateq.tCommandTimeout; //GLOBAL Constant
	tCmdStartTime   : TIME; // Time tracking
    currentTime		: TIME;
	bCmdInProgress  : BOOL; // Check fieldbus: 16#FFFF = In progress
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[// Default
M_CommandHandler 	:= CMD_IDLE;
currentTime 		:= DT_TO_TIME(P_SystemDateTime); // system time

CASE M_CommandHandler OF

	CMD_IDLE:
		IF stMappedIo.stRead.stRealtimeTestResults.bCycleEnd AND bCmd THEN
			M_CommandHandler := CMD_START;
			tCmdStartTime := currentTime;
		END_IF

	CMD_START:
		IF stMappedIo.stRead.anErrorCode[0] = 16#FF AND stMappedIo.stRead.anErrorCode[1] = 16#FF THEN
			M_CommandHandler := CMD_IN_PROGRESS;
		END_IF

	CMD_IN_PROGRESS:
		IF (currentTime - tCmdStartTime) > tTimeout THEN
			
			bCmd 		:= FALSE;
			M_CommandHandler := CMD_TIMEOUT;

		ELSIF	bCmdEcho = bCmd AND 						//CMD executed successfully
			   	stMappedIo.stRead.anErrorCode[0] = 0 AND
			   	stMappedIo.stRead.anErrorCode[1] = 0 THEN

			
			bCmd 		:= FALSE;
			M_CommandHandler := CMD_DONE;

		END_IF

	CMD_DONE:
		// Nothing to do, hold for logic above to act on done
		;

	CMD_ERROR:
		;
		
	CMD_TIMEOUT:
		
		IF bCmdError = bCmd THEN
			M_CommandHandler := CMD_ERROR;
		ELSE
			M_CommandHandler := CMD_TIMEOUT;
		END_IF
			

END_CASE

]]></ST>
      </Implementation>
    </Method>
