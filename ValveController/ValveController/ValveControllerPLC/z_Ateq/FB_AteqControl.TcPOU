    <Method Name="M_ProgramSelect" Id="{3f180883-986e-4f1d-b18a-91a389fa3ca6}">
      <Declaration><![CDATA[METHOD M_ProgramSelect : E_CommandStatus
VAR

END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[

	M_ProgramSelect := M_CommandHandler	(	bCmd 		:= stMappedIo.stWrite.stCommands.bProgramSelect,
											bCmdEcho	:= stMappedIo.stRead.stEcho.bProgramSelect,
											bCmdError	:= stMappedIo.stRead.stErrorCode.bProgramSelect
										);]]></ST>
      </Implementation>
    </Method>
