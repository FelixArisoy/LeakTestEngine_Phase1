    <Method Name="M_ProgramSelect" Id="{3f180883-986e-4f1d-b18a-91a389fa3ca6}">
      <Declaration><![CDATA[METHOD M_ProgramSelect : E_CommandStatus
VAR
   fbCmdHandler : FB_AteqCmdHandler;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[stIo.stWrite.nProgramNumber := nProgramNumber; // Set the program number register

fbCmdHandler(
   					bCmdEcho    := stIo.stRead.stEcho.bProgramSelect,
    				bCmdError   := stIo.stRead.stErrorCode.bProgramSelect,
					bCmdTrigger := stIo.stWrite.stCommands.bProgramSelect,
					stIo_Ref	:= StIo,
					eStatus		=> M_ProgramSelect
);

(*
// Clear the program number if needed
IF M_ProgramSelect = CMD_DONE OR M_ProgramSelect = CMD_ERROR OR M_ProgramSelect = CMD_TIMEOUT THEN
    stIo.stWrite.nProgramNumber := 0; 
END_IF
*)]]></ST>
      </Implementation>
    </Method>
    <Method Name="M_ProgramStart" Id="{df77a28a-31ae-4bb7-aada-fdddd0be9668}">
      <Declaration><![CDATA[METHOD M_ProgramStart : E_CommandStatus
VAR
   fbCmdHandler : FB_AteqCmdHandler;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[	

fbCmdHandler(
   					bCmdEcho    := stIo.stRead.stEcho.bStart,
    				bCmdError   := stIo.stRead.stErrorCode.bStart,
					bCmdTrigger := stIo.stWrite.stCommands.bStart,
					stIo_Ref	:= StIo,
					eStatus		=> M_ProgramStart
);]]></ST>
      </Implementation>
    </Method>
    <Method Name="M_ReadFIFO" Id="{2bd2f2bf-d1e5-497c-8c97-5c4c719656ec}">
      <Declaration><![CDATA[METHOD M_ReadFIFO : E_CommandStatus
VAR
     fbCmdHandler : FB_AteqCmdHandler;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[// This command also might simply trigger a data update from FIFO.
// Assuming it does have a command bit and echo/error bits for consistency.

fbCmdHandler(
   					bCmdEcho    := stIo.stRead.stEcho.bReadFIFO,
    				bCmdError   := stIo.stRead.stErrorCode.bReadFIFO,
					bCmdTrigger := stIo.stWrite.stCommands.bReadFIFO,
					stIo_Ref	:= StIo,
					eStatus		=> M_ReadFIFO
);
(*//////////////////// DEBUG HERE /////////////////////////
// If command is done, decode and store the FIFO result
IF M_ReadFIFO = CMD_DONE THEN
    // Assuming FIFO results come from a specific part of stIo.stRead
    // and you have a mechanism to store them in astFIFO.
    // Example: astFIFO[nFIFO_WritePointer] := DecodeAteqRawResults(stIo.stRead.stRawFIFOResult);
    // You'd need a FIFO write pointer and logic to manage the array
    // This decoding logic needs to be fully implemented.
END_IF
*)]]></ST>
      </Implementation>
    </Method>
    <Method Name="M_ReadLastResult" Id="{bca66d8f-b4be-4355-b92b-b0dac3f24c0c}">
      <Declaration><![CDATA[METHOD M_ReadLastResult : E_CommandStatus
VAR
    fbCmdHandler : FB_AteqCmdHandler;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[// This command might not follow the full handshake, but rather simply triggers a data update.
// Assuming it does have a command bit and echo/error bits for consistency.

fbCmdHandler(
   					bCmdEcho    := stIo.stRead.stEcho.bReadLastResult,
    				bCmdError   := stIo.stRead.stErrorCode.bReadLastResult,
					bCmdTrigger := stIo.stWrite.stCommands.bReadLastResult,
					stIo_Ref	:= StIo,
					eStatus		=> M_ReadLastResult
);



(* /////////////////DEBUG HERE//////////////////
// If command is done, decode the raw results
IF M_ReadLastResult = CMD_DONE THEN
    // Decode stIo.stRead.stRawResults into stLastResults here
    // Example: stLastResults.fPressure := stIo.stRead.stRawResults.nPressure * 0.001;
    // This decoding logic needs to be fully implemented based on ST_AteqMappedIo and ST_AteqResultsDecoded
    // For now, it's a placeholder.
    stLastResults.nProgramNumber := stIo.stRead.anTestResults[0]; // Example mapping
    stLastResults.fResultPressure := INT_TO_REAL(stIo.stRead.anTestResults[1]) * 0.001; // Example with scaling
    // Set pass/fail status based on stIo.stRead.stRealtimeTestResults.bPass / bFail
END_IF
*)]]></ST>
      </Implementation>
    </Method>
    <Method Name="M_ResetFIFO" Id="{d2dd068a-bc41-4e1b-8fe3-37e11fad9b4b}">
      <Declaration><![CDATA[METHOD M_ResetFIFO : E_CommandStatus
VAR
    fbCmdHandler : FB_AteqCmdHandler;
	
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[// This method solely encapsulates the FB_CommandHandler call for ResetFIFO.
// The 'bCmdTrigger' parameter is an IN_OUT. This means:
// 1. The value of stIo.stWrite.stCommands.bResetFIFO is passed IN.
// 2. FB_CommandHandler then internally manages this variable (setting it FALSE when done/error/timeout).
// 3. The new value is passed back OUT to stIo.stWrite.stCommands.bResetFIFO.

fbCmdHandler(
    bCmdEcho        := stIo.stRead.stEcho.bResetFIFO,
    bCmdError       := stIo.stRead.stErrorCode.bResetFIFO,
    bCmdTrigger     := stIo.stWrite.stCommands.bResetFIFO, // This is the IN_OUT - FB_CommandHandler will manage it
    stIo_Ref        := stIo 
);

M_ResetFIFO := fbCmdHandler.eStatus; // Return the status from the FB_CommandHandler instance

abDebug1 	:= fbCmdHandler.abDebug;
nCounter	:= fbCmdHandler.nCounter;]]></ST>
      </Implementation>
    </Method>
    <Method Name="M_SpecialCycle" Id="{d187d757-2cbf-4176-839b-3ef7d7928184}">
      <Declaration><![CDATA[METHOD M_SpecialCycle : E_CommandStatus
VAR_INPUT
    nSpecialCycleId			: WORD; // Input for the special cycle ID (GVL_AteqSpecialCycle.PiezoAutoZeroReg2 for AutoZero 16#08)
END_VAR
VAR
   fbCmdHandler : FB_AteqCmdHandler;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[stIo.stWrite.nSpecialCycle := nSpecialCycleId; // Set the special cycle ID register

fbCmdHandler(
   					bCmdEcho    := stIo.stRead.stEcho.bSpecialCycle,
    				bCmdError   := stIo.stRead.stErrorCode.bSpecialCycle,
					bCmdTrigger := stIo.stWrite.stCommands.bSpecialCycle,
					stIo_Ref	:= StIo,
					eStatus		=> M_SpecialCycle
);

// If the command is DONE or ERROR/TIMEOUT, clear the special cycle ID to prevent re-triggering
// or accidental setting if the command bit is accidentally re-asserted.

IF M_SpecialCycle = CMD_DONE OR M_SpecialCycle = CMD_ERROR OR M_SpecialCycle = CMD_TIMEOUT THEN
    stIo.stWrite.nSpecialCycle := 0; //Default
END_IF]]></ST>
      </Implementation>
    </Method>
    <Property Name="P_SystemDateTime" Id="{edbff775-b379-4408-8922-353bd74d8226}">
