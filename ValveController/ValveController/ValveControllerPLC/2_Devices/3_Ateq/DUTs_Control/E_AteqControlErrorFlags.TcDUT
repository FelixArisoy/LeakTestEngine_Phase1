<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <DUT Name="E_AteqControlErrorFlags" Id="{b9bb1472-4410-44b9-9f97-1d587d113e53}">
    <Declaration><![CDATA[{attribute 'qualified_only'}
{attribute 'strict'}
TYPE E_AteqControlErrorFlags :
(
	ParamReadFail,
	ParamWriteFail,
	ResetFIFOFail,  			// FIFO Reset failed (echo or timeout)
    AutoZeroFail,  				// Special Cycle command failed
    ProgramSelectFail,  		// Program select command failed
    ProgramStartFail, 			// Program start failed
    ReadLastResultFail,  		// ReadLastResult did not complete
    ResetDeviceFail,  			// General Reset command failed
	SpecialCycleFail,
    DeviceNotReady,  			// CycleEnd = 0 on startup
    DeviceCmdTimeout, 			// Echo bit never set within timeout
    DeviceCmdError  			// ErrorCode received from ATEQ
);
END_TYPE
]]></Declaration>
  </DUT>
</TcPlcObject>