<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.16">
  <DUT Name="ST_AteqRealtimeTestResults" Id="{f471bc97-779c-49f0-b883-ddd2ac5652bc}">
    <Declaration><![CDATA[TYPE ST_AteqRealtimeTestResults :
STRUCT
	// Byte 0 - 0Ch
    bPass                : BOOL; // Bit 0
    bFailPart            : BOOL; // Bit 1
    bFailRef             : BOOL; // Bit 2
    bAlarm               : BOOL; // Bit 3
    bPressureEror        : BOOL; // Bit 4
    bCycleEnd            : BOOL; // Bit 5
    bRecoverable         : BOOL; // Bit 6
    bCalibEror           : BOOL; // Bit 7

    // Byte 1 - 0Dh
    bCalibCheckEror      : BOOL; // Bit 0
    bATRFault            : BOOL; // Bit 1
    bReserved2           : BOOL; // Bit 2
    bReserved3           : BOOL; // Bit 3
    bReserved4           : BOOL; // Bit 4
    bReserved5           : BOOL; // Bit 5
    bReserved6           : BOOL; // Bit 6
    bReserved7           : BOOL; // Bit 7
	
END_STRUCT
END_TYPE
]]></Declaration>
  </DUT>
</TcPlcObject>