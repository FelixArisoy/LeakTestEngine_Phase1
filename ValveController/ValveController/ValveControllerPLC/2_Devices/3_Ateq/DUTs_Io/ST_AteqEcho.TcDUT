<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.16">
  <DUT Name="ST_AteqEcho" Id="{80c41e36-cd47-4d38-b0ee-934383f0bb01}">
    <Declaration><![CDATA[TYPE ST_AteqEcho :
STRUCT	
    // Byte 0 - 00h
    bReset                 	: BOOL; // Bit 0 Reset (stop the current cycle)
    bStart                 	: BOOL; // Bit 1 Start (Used for Test or Special cycle)
    bSpecialCycle          	: BOOL; // Bit 2 Load Special Cycle code selected at address 08h–09h
    bProgramSelect         	: BOOL; // Bit 3 Load Program # selection from 06-07h
    bReadFIFO       		: BOOL; // Bit 4 Read the FIFO cycles results
    bReadParams            	: BOOL; // Bit 5 Read of the parameters
    bWriteParams           	: BOOL; // Bit 6 Write of the parameters
    bResetFIFO             	: BOOL; // Bit 7 Reset of the results in FIFO 

    // Byte 1 - 01h
    bReadInstrumentConfig	: BOOL; // Bit 0 Read of the instrument configuration
    bReadConfigMenuBits		: BOOL; // Bit 1 Read of the general bits.
    bReadFunctionBits      	: BOOL; // Bit 2 Read of the normal bits.
    bWriteExtMenu          	: BOOL; // Bit 3 Write of the general bits.
    bWriteFunctionBits     	: BOOL; // Bit 4 Write of the normal bits.
    bReadProgramName       	: BOOL; // Bit 5 Read of the program personalisation
    bWriteProgramName      	: BOOL; // Bit 6 Write of the program personalisation.
    bReadLastResult        	: BOOL; // Bit 7 Load Last result pressure and leak data to address 20h
	
END_STRUCT
END_TYPE
]]></Declaration>
  </DUT>
</TcPlcObject>