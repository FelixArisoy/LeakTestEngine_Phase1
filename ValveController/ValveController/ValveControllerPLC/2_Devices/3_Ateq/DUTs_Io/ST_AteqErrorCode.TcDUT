<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <DUT Name="ST_AteqErrorCode" Id="{ca34406b-f405-4d37-a2b3-a9b3cb2956fb}">
    <Declaration><![CDATA[TYPE ST_AteqErrorCode :
STRUCT	
	// Byte 0 - 02h
    bReset                 	: BOOL; // Bit 0 Reset error
    bStart                 	: BOOL; // Bit 1 Start error
    bSpecialCycle          	: BOOL; // Bit 2 Special cycle error
    bProgramSelect         	: BOOL; // Bit 3 Program selection error
    bReadFIFO       		: BOOL; // Bit 4 Reading of the results FIFO error
    bReadParams            	: BOOL; // Bit 5 Reading of the parameters error
    bWriteParams           	: BOOL; // Bit 6 Writing of the parameters error
    bResetFIFO             	: BOOL; // Bit 7 Reset of the results FIFO error

    // Byte 1 - 03h
    bReadInstrumentConfig	: BOOL; // Bit 0 Reading of the instrument configuration error
    bReadConfigMenuBits		: BOOL; // Bit 1 Reading of the general bits error
    bReadFunctionBits      	: BOOL; // Bit 2 Reading of the normal bits error
    bWriteExtMenu          	: BOOL; // Bit 3 Writing of the general bits error
    bWriteFunctionBits     	: BOOL; // Bit 4 Writing of the normal bits error
    bReadProgramName       	: BOOL; // Bit 5 Reading of the program personalisation error
    bWriteProgramName      	: BOOL; // Bit 6 Writing of the program personalisation error
    bReadLastResult        	: BOOL; // Bit 7 Writing Last Result Error
	
END_STRUCT
END_TYPE
]]></Declaration>
  </DUT>
</TcPlcObject>