<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.15">
  <POU Name="FB_Test_AteqComm" Id="{b608c7ab-a9f5-4d6a-ae95-38172be6353d}" SpecialFunc="None">
    <Declaration><![CDATA[FUNCTION_BLOCK FB_Test_AteqComm
VAR
 
	fbTestSuite			: TcUnit.FB_TestSuite;
	
	nDeviceIndex 		: UINT	:= 0;	
    fbTestAteqComm		: FB_AteqComm;
	stTestAteqRawIo		: ST_AteqRawIo;
	stTestAteqMappedIo	: ST_AteqMappedIo;
	  

	result : BOOL;
	state : INT := 0;  // To keep track of which test to run
    done  : BOOL := FALSE;
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[
        Test_InputMapBigEndian();
		Test_InputMapLittleEndian();
		Test_OutputMapBigEndian();
		Test_OutputMapLittleEndian();
		]]></ST>
    </Implementation>
    <Method Name="Test_InputMapBigEndian" Id="{33e14d08-4505-41cf-8bcb-360c35b2be3d}">
      <Declaration><![CDATA[METHOD Test_InputMapBigEndian
VAR
	nIndex1 : INT;
	nIndex2	: BYTE;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[
// --- Big Endian InputMapping Test ---
TEST('InputMapping - Big Endian');

// Clear inputs
FOR nIndex1 := 0 TO 255 DO
	stTestAteqRawIo.anInput[nIndex1 / 64][nIndex1 MOD 64] := 0;
END_FOR

GVL_Ateq.eDeviceEndianSetTo := E_Endianness.BigEndian;

// Reuse the **same** byte order inputs (low byte first in index 6)
stTestAteqRawIo.anInput[0][6] := 16#07;  // ProgramInUse Low byte
stTestAteqRawIo.anInput[0][7] := 16#08;  // ProgramInUse High byte

stTestAteqRawIo.anInput[0][8] := 16#09;  // ResultsInFifo Low byte
stTestAteqRawIo.anInput[0][9] := 16#0A;  // ResultsInFifo High byte

stTestAteqRawIo.anInput[0][10] := 16#0B; // TestType Low byte
stTestAteqRawIo.anInput[0][11] := 16#0C; // TestType High byte

stTestAteqRawIo.anInput[0][14] := 16#0F; // ProgramStep Low byte
stTestAteqRawIo.anInput[0][15] := 16#10; // ProgramStep High byte

// PressureCurValue DWORD
stTestAteqRawIo.anInput[0][16] := 16#11;
stTestAteqRawIo.anInput[0][17] := 16#12;
stTestAteqRawIo.anInput[0][18] := 16#13;
stTestAteqRawIo.anInput[0][19] := 16#14;

// PressureUnitCode DWORD
stTestAteqRawIo.anInput[0][20] := 16#15;
stTestAteqRawIo.anInput[0][21] := 16#16;
stTestAteqRawIo.anInput[0][22] := 16#17;
stTestAteqRawIo.anInput[0][23] := 16#18;

// LeakCurValue DWORD
stTestAteqRawIo.anInput[0][24] := 16#19;
stTestAteqRawIo.anInput[0][25] := 16#1A;
stTestAteqRawIo.anInput[0][26] := 16#1B;
stTestAteqRawIo.anInput[0][27] := 16#1C;

// LeakUnitCode DWORD
stTestAteqRawIo.anInput[0][28] := 16#1D;
stTestAteqRawIo.anInput[0][29] := 16#1E;
stTestAteqRawIo.anInput[0][30] := 16#1F;
stTestAteqRawIo.anInput[0][31] := 16#20;

// ExchangeZone as before
FOR nIndex2 := 0 TO 127 DO
	stTestAteqRawIo.anInput[(32 + nIndex2) / 64][(32 + nIndex2) MOD 64] := 33 + nIndex2;
END_FOR

// Run Mapping
fbTestAteqComm(nDeviceIndex := nDeviceIndex, stRawIo := stTestAteqRawIo, stMappedIo := stTestAteqMappedIo);

// Validate WORDs - Big Endian means high byte first, so expected values reversed from Little Endian
fbTestSuite.AssertEquals_WORD(16#0708, stTestAteqMappedIo.stRead.nProgramInUse, 'ProgramInUse mismatch');
fbTestSuite.AssertEquals_WORD(16#090A, stTestAteqMappedIo.stRead.nResultsInFifo, 'ResultsInFifo mismatch');
fbTestSuite.AssertEquals_WORD(16#0B0C, stTestAteqMappedIo.stRead.nTestType, 'TestType mismatch');
fbTestSuite.AssertEquals_WORD(16#0F10, stTestAteqMappedIo.stRead.nProgramStep, 'ProgramStep mismatch');

// Validate REAL PressureCurValue
fbTestSuite.AssertEquals_REAL(
    336.794,
    stTestAteqMappedIo.stRead.nPressureCurValue,
    0,
    'PressureCurValue mismatch'
);

// Validate DWORD PressureUnitCode
fbTestSuite.AssertEquals_DWORD(16#18171615, stTestAteqMappedIo.stRead.nPressureUnitCode, 'PressureUnitCode mismatch');

// Validate REAL LeakCurValue
fbTestSuite.AssertEquals_REAL(
    47.153,
    stTestAteqMappedIo.stRead.nLeakCurValue,
    0,
    'LeakCurValue mismatch'
);

// Validate DWORD LeakUnitCode
fbTestSuite.AssertEquals_DWORD(16#201F1E1D, stTestAteqMappedIo.stRead.nLeakUnitCode, 'LeakUnitCode mismatch');

TEST_FINISHED();
]]></ST>
      </Implementation>
    </Method>
    <Method Name="Test_InputMapLittleEndian" Id="{d1f3064e-0c98-46ee-b01b-a927794569d8}">
      <Declaration><![CDATA[METHOD Test_InputMapLittleEndian
VAR
	nIndex1 : INT;
	nIndex2	: BYTE;
END_VAR


]]></Declaration>
      <Implementation>
        <ST><![CDATA[// --- Little Endian InputMapping Test ---
TEST('InputMapping - Little Endian');

// Clear inputs
FOR nIndex1 := 0 TO 255 DO
	stTestAteqRawIo.anInput[nIndex1 / 64][nIndex1 MOD 64] := 0;
END_FOR

GVL_Ateq.eDeviceEndianSetTo := E_Endianness.LittleEndian;

// Setup bytes (same order for both tests - low byte first)
stTestAteqRawIo.anInput[0][6] := 16#07;  // ProgramInUse Low byte
stTestAteqRawIo.anInput[0][7] := 16#08;  // ProgramInUse High byte

stTestAteqRawIo.anInput[0][8] := 16#09;  // ResultsInFifo Low byte
stTestAteqRawIo.anInput[0][9] := 16#0A;  // ResultsInFifo High byte

stTestAteqRawIo.anInput[0][10] := 16#0B; // TestType Low byte
stTestAteqRawIo.anInput[0][11] := 16#0C; // TestType High byte

stTestAteqRawIo.anInput[0][14] := 16#0F; // ProgramStep Low byte
stTestAteqRawIo.anInput[0][15] := 16#10; // ProgramStep High byte

// PressureCurValue DWORD (4 bytes, low byte first)
stTestAteqRawIo.anInput[0][16] := 16#11;
stTestAteqRawIo.anInput[0][17] := 16#12;
stTestAteqRawIo.anInput[0][18] := 16#13;
stTestAteqRawIo.anInput[0][19] := 16#14;

// PressureUnitCode DWORD
stTestAteqRawIo.anInput[0][20] := 16#15;
stTestAteqRawIo.anInput[0][21] := 16#16;
stTestAteqRawIo.anInput[0][22] := 16#17;
stTestAteqRawIo.anInput[0][23] := 16#18;

// LeakCurValue DWORD
stTestAteqRawIo.anInput[0][24] := 16#19;
stTestAteqRawIo.anInput[0][25] := 16#1A;
stTestAteqRawIo.anInput[0][26] := 16#1B;
stTestAteqRawIo.anInput[0][27] := 16#1C;

// LeakUnitCode DWORD
stTestAteqRawIo.anInput[0][28] := 16#1D;
stTestAteqRawIo.anInput[0][29] := 16#1E;
stTestAteqRawIo.anInput[0][30] := 16#1F;
stTestAteqRawIo.anInput[0][31] := 16#20;

// ExchangeZone setup
FOR nIndex2 := 0 TO 127 DO
	stTestAteqRawIo.anInput[(32 + nIndex2) / 64][(32 + nIndex2) MOD 64] := 33 + nIndex2;
END_FOR

// Run Mapping
fbTestAteqComm(nDeviceIndex := nDeviceIndex, stRawIo := stTestAteqRawIo, stMappedIo := stTestAteqMappedIo);

// Validate WORDs - Little Endian means low byte first, so 0x0807 for nProgramInUse is 0x0708 logically
fbTestSuite.AssertEquals_WORD(16#0807, stTestAteqMappedIo.stRead.nProgramInUse, 'ProgramInUse mismatch');
fbTestSuite.AssertEquals_WORD(16#0A09, stTestAteqMappedIo.stRead.nResultsInFifo, 'ResultsInFifo mismatch');
fbTestSuite.AssertEquals_WORD(16#0C0B, stTestAteqMappedIo.stRead.nTestType, 'TestType mismatch');
fbTestSuite.AssertEquals_WORD(16#100F, stTestAteqMappedIo.stRead.nProgramStep, 'ProgramStep mismatch');

// Validate REAL PressureCurValue (bytes interpreted as DWORD, then converted properly to REAL)
fbTestSuite.AssertEquals_REAL(
    336.794,  // your expected real value after conversion/dividing by 1000 etc
    stTestAteqMappedIo.stRead.nPressureCurValue, 
    0,
    'PressureCurValue mismatch'
);

// Validate DWORD PressureUnitCode (bytes in order)
fbTestSuite.AssertEquals_DWORD(16#18171615, stTestAteqMappedIo.stRead.nPressureUnitCode, 'PressureUnitCode mismatch');

// Validate REAL LeakCurValue (converted from DWORD bytes)
fbTestSuite.AssertEquals_REAL(
    47.153,
    stTestAteqMappedIo.stRead.nLeakCurValue,
    0,
    'LeakCurValue mismatch'
);

// Validate DWORD LeakUnitCode
fbTestSuite.AssertEquals_DWORD(16#201F1E1D, stTestAteqMappedIo.stRead.nLeakUnitCode, 'LeakUnitCode mismatch');

// ExchangeZone validation...

TEST_FINISHED();

]]></ST>
      </Implementation>
    </Method>
    <Method Name="Test_OutputMapBigEndian" Id="{47acdd83-d543-40c8-be50-dd0d05061644}">
      <Declaration><![CDATA[METHOD Test_OutputMapBigEndian
VAR_INPUT
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[// -------- Big Endian Test --------
TEST('OutputMapping_BigEndian');
GVL_Ateq.eDeviceEndianSetTo := E_Endianness.BigEndian;

stTestAteqMappedIo.stWrite.nProgramSelect := 16#1122;
stTestAteqMappedIo.stWrite.nSpecialCycle := 16#3344;

// Re-run same FB call to update mapping for big endian
fbTestAteqComm(nDeviceIndex := nDeviceIndex, stRawIo := stTestAteqRawIo, stMappedIo := stTestAteqMappedIo);

fbTestSuite.AssertEquals_BYTE(16#11, stTestAteqRawIo.anOutput[0][6], 'BigEndian: ProgramSelect[HighByte] mismatch');
fbTestSuite.AssertEquals_BYTE(16#22, stTestAteqRawIo.anOutput[0][7], 'BigEndian: ProgramSelect[LowByte] mismatch');
fbTestSuite.AssertEquals_BYTE(16#33, stTestAteqRawIo.anOutput[0][8], 'BigEndian: SpecialCycle[HighByte] mismatch');
fbTestSuite.AssertEquals_BYTE(16#44, stTestAteqRawIo.anOutput[0][9], 'BigEndian: SpecialCycle[LowByte] mismatch');

TEST_FINISHED();
]]></ST>
      </Implementation>
    </Method>
    <Method Name="Test_OutputMapLittleEndian" Id="{f4de2307-dc02-4b4d-847b-42d7be068a06}">
      <Declaration><![CDATA[METHOD Test_OutputMapLittleEndian
VAR
	nIndex: BYTE;	
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[TEST('OutputMapping_LittleEndian');
GVL_Ateq.eDeviceEndianSetTo := E_Endianness.LittleEndian;

// Set known values
stTestAteqMappedIo.stWrite.stCommands.bReset               := TRUE;
stTestAteqMappedIo.stWrite.stCommands.bStart               := TRUE;
stTestAteqMappedIo.stWrite.stCommands.bSpecialCycle        := TRUE;
stTestAteqMappedIo.stWrite.stCommands.bProgramSelect       := TRUE;
stTestAteqMappedIo.stWrite.stCommands.bReadFifoResults     := TRUE;
stTestAteqMappedIo.stWrite.stCommands.bReadParameters      := TRUE;
stTestAteqMappedIo.stWrite.stCommands.bWriteParameters     := TRUE;
stTestAteqMappedIo.stWrite.stCommands.bResetFifo           := TRUE;
stTestAteqMappedIo.stWrite.stCommands.bReadInstrumentConfig := TRUE;
stTestAteqMappedIo.stWrite.stCommands.bReadConfig          := TRUE;
stTestAteqMappedIo.stWrite.stCommands.bReadFunctionBits    := TRUE;
stTestAteqMappedIo.stWrite.stCommands.bWriteExtMenu        := TRUE;
stTestAteqMappedIo.stWrite.stCommands.bWriteFunctionBits   := TRUE;
stTestAteqMappedIo.stWrite.stCommands.bReadProgramName     := TRUE;
stTestAteqMappedIo.stWrite.stCommands.bWriteProgramName    := TRUE;
stTestAteqMappedIo.stWrite.stCommands.bReadLastResult      := TRUE;

stTestAteqMappedIo.stWrite.anReservedOut1[0] := 161;
stTestAteqMappedIo.stWrite.anReservedOut1[1] := 162;
stTestAteqMappedIo.stWrite.anReservedOut1[2] := 163;
stTestAteqMappedIo.stWrite.anReservedOut1[3] := 164;

stTestAteqMappedIo.stWrite.nProgramSelect := 16#1122;
stTestAteqMappedIo.stWrite.nSpecialCycle := 16#3344;

FOR nIndex := 0 TO 21 DO
    stTestAteqMappedIo.stWrite.anReservedOut2[nIndex] := 80 + nIndex;
END_FOR
FOR nIndex := 0 TO 127 DO
    stTestAteqMappedIo.stWrite.anExchangeZone[nIndex] := 192 + nIndex;
END_FOR

fbTestAteqComm(nDeviceIndex := nDeviceIndex, stRawIo := stTestAteqRawIo, stMappedIo := stTestAteqMappedIo);

fbTestSuite.AssertEquals_BYTE(255, stTestAteqRawIo.anOutput[0][0], 'CommandByte0 mismatch');
fbTestSuite.AssertEquals_BYTE(255, stTestAteqRawIo.anOutput[0][1], 'CommandByte1 mismatch');

fbTestSuite.AssertEquals_BYTE(161, stTestAteqRawIo.anOutput[0][2], 'ReservedOut1[0] mismatch');
fbTestSuite.AssertEquals_BYTE(162, stTestAteqRawIo.anOutput[0][3], 'ReservedOut1[1] mismatch');
fbTestSuite.AssertEquals_BYTE(163, stTestAteqRawIo.anOutput[0][4], 'ReservedOut1[2] mismatch');
fbTestSuite.AssertEquals_BYTE(164, stTestAteqRawIo.anOutput[0][5], 'ReservedOut1[3] mismatch');

fbTestSuite.AssertEquals_BYTE(16#22, stTestAteqRawIo.anOutput[0][6], 'ProgramSelect[LowByte] mismatch');
fbTestSuite.AssertEquals_BYTE(16#11, stTestAteqRawIo.anOutput[0][7], 'ProgramSelect[HighByte] mismatch');
fbTestSuite.AssertEquals_BYTE(16#44, stTestAteqRawIo.anOutput[0][8], 'SpecialCycle[LowByte] mismatch');
fbTestSuite.AssertEquals_BYTE(16#33, stTestAteqRawIo.anOutput[0][9], 'SpecialCycle[HighByte] mismatch');

FOR nIndex := 0 TO 21 DO
    fbTestSuite.AssertEquals_BYTE(80 + nIndex, stTestAteqRawIo.anOutput[0][10 + nIndex], CONCAT(CONCAT('ReservedOut2[', INT_TO_STRING(nIndex)), '] mismatch'));
END_FOR

FOR nIndex := 0 TO 127 DO
    fbTestSuite.AssertEquals_BYTE(192 + nIndex, stTestAteqRawIo.anOutput[(32 + nIndex) / 64][(32 + nIndex) MOD 64], CONCAT(CONCAT('ExchangeZone[', INT_TO_STRING(nIndex)), '] mismatch'));
END_FOR

TEST_FINISHED();]]></ST>
      </Implementation>
    </Method>
