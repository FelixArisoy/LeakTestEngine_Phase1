<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.15">
  <GVL Name="GVL_AteqConfig" Id="{8341f924-21b8-4660-ac80-fb81e367c10a}">
    <Declaration><![CDATA[VAR_GLOBAL CONSTANT
    nMaxDeviceCount : UINT 	:= 1; // Set; based on Total Num of F6 ATEQ devices
	tCommandTimeout	: TIME 	:= T#30S; //Sets AteqControl CmdHandlerMethod Timeout
	tTestTimeOut	: TIME 	:= T#120S;
	tAutoSeqTimeout	: TIME 	:= T#300S;
	nMaxResultStore	: INT	:= 99;	//FB_ResultHandler Result buffer array limit
	nMaxTestSteps	: INT	:= 10;	
	nMaxProgramsToRun	: INT := 33;
	
	// CmdHandler Timers
	tCmdTimeout 		: TIME := T#5000MS; // Debug Future; can be limitted by the TestRunTime tru ParamRead
	tCmdInProgressDWELL : TIME := T#300MS;	// Must be atleast 300ms. DEBUG; Monitor network lags with multiple ATEQ runs
	tCmdDoneDWELL 		: TIME := T#50MS;

END_VAR

VAR_GLOBAL
	
	eDeviceEndianSetTo 	: E_AteqEndianType; // Temp Set Profinet testing ATEQ
	
END_VAR
]]></Declaration>
  </GVL>
</TcPlcObject>