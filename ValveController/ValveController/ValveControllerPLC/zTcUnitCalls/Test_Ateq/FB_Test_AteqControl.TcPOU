<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <POU Name="FB_Test_AteqControl" Id="{2a34a3c3-1d83-451d-84a7-ef9326ab65d3}" SpecialFunc="None">
    <Declaration><![CDATA[FUNCTION_BLOCK FB_Test_AteqControl EXTENDS TcUnit.FB_TestSuite
VAR_INPUT
END_VAR
VAR_OUTPUT
END_VAR
VAR	
// Test Map Io	
	nDeviceIndex 		: UINT	:= 0;	
	stTestAteqRawIo		: ST_AteqRawIo;
	stTestAteqMappedIo	: ST_AteqMapIo;
	  
// Test Control Methods	
    fbTestInstance : FB_AteqControl;
    stTestIo       : ST_AteqMapIo;

    bTestStarted   : BOOL := FALSE;
    nTestStep      : INT := 0;
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[	// Test Map Io
	Test_InputMapBigEndian();		

	Test_InputMapLittleEndian();

	Test_OutputMapBigEndian();

	Test_OutputMapLittleEndian();



CASE nTestStep OF

    0: // Initialize inputs and call FB
        stTestIo.Read.RealtimeStateBit.bCycleEnd := TRUE; // Simulate ATEQ ready
        
        fbTestInstance(
						nProgramNumberToRun 			:= 0,
						bProgramSeqRunRequest 		:= TRUE,
						bProgramSeqResetRequest 	:= FALSE,
						stMapIo 					:= stTestIo
);
		nTestStep := 1;
    1: // Call FB, check transition to RESET_FIFO

        IF fbTestInstance.eProgramSeqSteps = SEQ_RESET_FIFO THEN
            AssertTrue(TRUE, 'Transitioned to SEQ_RESET_FIFO');
            nTestStep := 2;
        END_IF

    2: // Simulate FIFO reset done
        stTestIo.Read.nResultsInFifo := 0;

        fbTestInstance(
						nProgramNumberToRun 			:= 0,
						bProgramSeqRunRequest 		:= TRUE,
						bProgramSeqResetRequest 	:= FALSE,
						stMapIo 					:= stTestIo
);

        IF fbTestInstance.eProgramSeqSteps = SEQ_AUTO_ZERO THEN
            AssertTrue(TRUE, 'Transitioned to SEQ_AUTO_ZERO');
            nTestStep := 3;
        END_IF

    3: // Simulate AutoZero done
        fbTestInstance.bAutoZeroComplete := TRUE;

        fbTestInstance(
						nProgramNumberToRun 			:= 0,
						bProgramSeqRunRequest 		:= TRUE,
						bProgramSeqResetRequest 	:= FALSE,
						stMapIo 					:= stTestIo
);

        IF fbTestInstance.eProgramSeqSteps = SEQ_PROGRAM_SELECT THEN
            AssertTrue(TRUE, 'Transitioned to SEQ_PROGRAM_SELECT');
            nTestStep := 4;
        END_IF

    4: // Simulate ProgramSelect complete
        stTestIo.Read.EchoBit.bProgramSelect := TRUE;

        fbTestInstance(
						nProgramNumberToRun 			:= 0,
						bProgramSeqRunRequest 		:= TRUE,
						bProgramSeqResetRequest 	:= FALSE,
						stMapIo 					:= stTestIo
);

        fbTestInstance.bProgramSelectComplete := TRUE;

        fbTestInstance(
						nProgramNumberToRun 			:= 0,
						bProgramSeqRunRequest 		:= TRUE,
						bProgramSeqResetRequest 	:= FALSE,
						stMapIo 					:= stTestIo
);

        IF fbTestInstance.eProgramSeqSteps = SEQ_START_PROGRAM THEN
            AssertTrue(TRUE, 'Transitioned to SEQ_START_PROGRAM');
            nTestStep := 100;
        END_IF

    100: // Final Step
        ; // Test Done

END_CASE
]]></ST>
    </Implementation>
    <Method Name="Test_InputMapBigEndian" Id="{33e14d08-4505-41cf-8bcb-360c35b2be3d}">
      <Declaration><![CDATA[METHOD Test_InputMapBigEndian
VAR
	nIndex1 : INT;
	nIndex2	: BYTE;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[
// --- Big Endian InputMapping Test ---
TEST('InputMapping_Big Endian');

// Clear inputs
FOR nIndex1 := 0 TO 255 DO
	stTestAteqRawIo.InByte[nIndex1 / 64][nIndex1 MOD 64] := 0;
END_FOR

GVL_AteqConfig.eDeviceEndianSetTo := E_AteqEndianType.BigEndian;

// Reuse the **same** byte order inputs (low byte first in index 6)
stTestAteqRawIo.InByte[0][6] := 16#07;  // ProgramInUse Low byte
stTestAteqRawIo.InByte[0][7] := 16#08;  // ProgramInUse High byte

stTestAteqRawIo.InByte[0][8] := 16#09;  // ResultsInFifo Low byte
stTestAteqRawIo.InByte[0][9] := 16#0A;  // ResultsInFifo High byte

stTestAteqRawIo.InByte[0][10] := 16#0B; // TestType Low byte
stTestAteqRawIo.InByte[0][11] := 16#0C; // TestType High byte

stTestAteqRawIo.InByte[0][14] := 16#0F; // ProgramStep Low byte
stTestAteqRawIo.InByte[0][15] := 16#10; // ProgramStep High byte

// PressureCurValue DWORD
stTestAteqRawIo.InByte[0][16] := 16#11;
stTestAteqRawIo.InByte[0][17] := 16#12;
stTestAteqRawIo.InByte[0][18] := 16#13;
stTestAteqRawIo.InByte[0][19] := 16#14;

// PressureUnitCode DWORD
stTestAteqRawIo.InByte[0][20] := 16#15;
stTestAteqRawIo.InByte[0][21] := 16#16;
stTestAteqRawIo.InByte[0][22] := 16#17;
stTestAteqRawIo.InByte[0][23] := 16#18;

// LeakCurValue DWORD
stTestAteqRawIo.InByte[0][24] := 16#19;
stTestAteqRawIo.InByte[0][25] := 16#1A;
stTestAteqRawIo.InByte[0][26] := 16#1B;
stTestAteqRawIo.InByte[0][27] := 16#1C;

// LeakUnitCode DWORD
stTestAteqRawIo.InByte[0][28] := 16#1D;
stTestAteqRawIo.InByte[0][29] := 16#1E;
stTestAteqRawIo.InByte[0][30] := 16#1F;
stTestAteqRawIo.InByte[0][31] := 16#20;

// ExchangeZone as before
FOR nIndex2 := 0 TO 127 DO
	stTestAteqRawIo.InByte[(32 + nIndex2) / 64][(32 + nIndex2) MOD 64] := 33 + nIndex2;
END_FOR

// Run Mapping
//fbTestAteqComm(nDeviceIndex := nDeviceIndex, stRawIo := stTestAteqRawIo, stMappedIo := stTestAteqMappedIo);

// Validate WORDs - Big Endian means high byte first, so expected values reversed from Little Endian
AssertEquals_WORD(16#0807, stTestAteqMappedIo.Read.nProgramInUse, 'ProgramInUse mismatch');
AssertEquals_WORD(16#0A09, stTestAteqMappedIo.Read.nResultsInFifo, 'ResultsInFifo mismatch');
AssertEquals_WORD(16#0C0B, stTestAteqMappedIo.Read.nTestType, 'TestType mismatch');
AssertEquals_WORD(16#100F, stTestAteqMappedIo.Read.nProgramStep, 'ProgramStep mismatch');

// Validate REAL PressureCurValue 16#14131211
AssertEquals_REAL(
    336794.129,
    stTestAteqMappedIo.Read.fPressureCurValue,
    0.1,
    'PressureCurValue mismatch'
);

// Validate DWORD PressureUnitCode
AssertEquals_DWORD(16#18171615, stTestAteqMappedIo.Read.nPressureUnitCode, 'PressureUnitCode mismatch');

// Validate REAL LeakCurValue 16#1C1B1A19
AssertEquals_REAL(
    47153.8201,
    stTestAteqMappedIo.Read.fLeakCurValue,
    0.1,
    'LeakCurValue mismatch'
);

// Validate DWORD LeakUnitCode
AssertEquals_DWORD(16#201F1E1D, stTestAteqMappedIo.Read.nLeakUnitCode, 'LeakUnitCode mismatch');

TEST_FINISHED();
]]></ST>
      </Implementation>
    </Method>
    <Method Name="Test_InputMapLittleEndian" Id="{d1f3064e-0c98-46ee-b01b-a927794569d8}">
      <Declaration><![CDATA[METHOD Test_InputMapLittleEndian
VAR
	nIndex1 : INT;
	nIndex2	: BYTE;
END_VAR


]]></Declaration>
      <Implementation>
        <ST><![CDATA[// --- Little Endian InputMapping Test ---
TEST('InputMapping_Little Endian');

// Clear inputs
FOR nIndex1 := 0 TO 255 DO
	stTestAteqRawIo.InByte[nIndex1 / 64][nIndex1 MOD 64] := 0;
END_FOR

GVL_AteqConfig.eDeviceEndianSetTo := E_AteqEndianType.LittleEndian;

// Setup bytes (same order for both tests - low byte first)
stTestAteqRawIo.InByte[0][6] := 16#07;  // ProgramInUse Low byte
stTestAteqRawIo.InByte[0][7] := 16#08;  // ProgramInUse High byte

stTestAteqRawIo.InByte[0][8] := 16#09;  // ResultsInFifo Low byte
stTestAteqRawIo.InByte[0][9] := 16#0A;  // ResultsInFifo High byte

stTestAteqRawIo.InByte[0][10] := 16#0B; // TestType Low byte
stTestAteqRawIo.InByte[0][11] := 16#0C; // TestType High byte

stTestAteqRawIo.InByte[0][14] := 16#0F; // ProgramStep Low byte
stTestAteqRawIo.InByte[0][15] := 16#10; // ProgramStep High byte

// PressureCurValue DWORD (4 bytes, low byte first)
stTestAteqRawIo.InByte[0][16] := 16#11;
stTestAteqRawIo.InByte[0][17] := 16#12;
stTestAteqRawIo.InByte[0][18] := 16#13;
stTestAteqRawIo.InByte[0][19] := 16#14;

// PressureUnitCode DWORD
stTestAteqRawIo.InByte[0][20] := 16#15;
stTestAteqRawIo.InByte[0][21] := 16#16;
stTestAteqRawIo.InByte[0][22] := 16#17;
stTestAteqRawIo.InByte[0][23] := 16#18;

// LeakCurValue DWORD
stTestAteqRawIo.InByte[0][24] := 16#19;
stTestAteqRawIo.InByte[0][25] := 16#1A;
stTestAteqRawIo.InByte[0][26] := 16#1B;
stTestAteqRawIo.InByte[0][27] := 16#1C;

// LeakUnitCode DWORD
stTestAteqRawIo.InByte[0][28] := 16#1D;
stTestAteqRawIo.InByte[0][29] := 16#1E;
stTestAteqRawIo.InByte[0][30] := 16#1F;
stTestAteqRawIo.InByte[0][31] := 16#20;

// ExchangeZone setup
FOR nIndex2 := 0 TO 127 DO
	stTestAteqRawIo.InByte[(32 + nIndex2) / 64][(32 + nIndex2) MOD 64] := 33 + nIndex2;
END_FOR

// Run Mapping
//fbTestAteqComm(nDeviceIndex := nDeviceIndex, stRawIo := stTestAteqRawIo, stMappedIo := stTestAteqMappedIo);

// Validate WORDs - Little Endian means low byte first, so 0x0807 for nProgramInUse is 0x0708 logically
AssertEquals_WORD(16#0708, stTestAteqMappedIo.Read.nProgramInUse, 'ProgramInUse mismatch');
AssertEquals_WORD(16#090A, stTestAteqMappedIo.Read.nResultsInFifo, 'ResultsInFifo mismatch');
AssertEquals_WORD(16#0B0C, stTestAteqMappedIo.Read.nTestType, 'TestType mismatch');
AssertEquals_WORD(16#0F10, stTestAteqMappedIo.Read.nProgramStep, 'ProgramStep mismatch');

// Validate REAL PressureCurValue 16#11121314
AssertEquals_REAL(
    286397.204,  // your expected real value after conversion/dividing by 1000 etc
    stTestAteqMappedIo.Read.fPressureCurValue, 
    0.1,
    'PressureCurValue mismatch'
);

// Validate DWORD PressureUnitCode 
AssertEquals_DWORD(16#15161718, stTestAteqMappedIo.Read.nPressureUnitCode, 'PressureUnitCode mismatch');

// Validate REAL LeakCurValue 16#191A1B1C
AssertEquals_REAL(
    42114.1276,
    stTestAteqMappedIo.Read.fLeakCurValue,
    0.1,
    'LeakCurValue mismatch'
);

// Validate DWORD LeakUnitCode
AssertEquals_DWORD(16#1D1E1F20, stTestAteqMappedIo.Read.nLeakUnitCode, 'LeakUnitCode mismatch');

// ExchangeZone validation...

TEST_FINISHED();

]]></ST>
      </Implementation>
    </Method>
    <Method Name="Test_OutputMapBigEndian" Id="{47acdd83-d543-40c8-be50-dd0d05061644}">
      <Declaration><![CDATA[METHOD Test_OutputMapBigEndian
VAR_INPUT
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[// -------- Big Endian Test --------
TEST('OutputMapping_BigEndian');
GVL_AteqConfig.eDeviceEndianSetTo := E_AteqEndianType.BigEndian;

stTestAteqMappedIo.Write.nProgramNumber := 16#2211;
stTestAteqMappedIo.Write.nSpecialCycle := 16#4433;

// Re-run same FB call to update mapping for big endian
//fbTestAteqComm(nDeviceIndex := nDeviceIndex, stRawIo := stTestAteqRawIo, stMappedIo := stTestAteqMappedIo);

AssertEquals_BYTE(16#11, stTestAteqRawIo.OutByte[0][6], 'BigEndian: ProgramSelect[HighByte] mismatch');
AssertEquals_BYTE(16#22, stTestAteqRawIo.OutByte[0][7], 'BigEndian: ProgramSelect[LowByte] mismatch');
AssertEquals_BYTE(16#33, stTestAteqRawIo.OutByte[0][8], 'BigEndian: SpecialCycle[HighByte] mismatch');
AssertEquals_BYTE(16#44, stTestAteqRawIo.OutByte[0][9], 'BigEndian: SpecialCycle[LowByte] mismatch');

TEST_FINISHED();
]]></ST>
      </Implementation>
    </Method>
    <Method Name="Test_OutputMapLittleEndian" Id="{f4de2307-dc02-4b4d-847b-42d7be068a06}">
      <Declaration><![CDATA[METHOD Test_OutputMapLittleEndian
VAR
	nIndex: BYTE;	
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[TEST('OutputMapping_LittleEndian');
GVL_AteqConfig.eDeviceEndianSetTo := E_AteqEndianType.LittleEndian;

// Set known values
stTestAteqMappedIo.Write.CmdBit.bReset               := TRUE;
stTestAteqMappedIo.Write.CmdBit.bStart               := TRUE;
stTestAteqMappedIo.Write.CmdBit.bSpecialCycle        := TRUE;
stTestAteqMappedIo.Write.CmdBit.bProgramSelect       := TRUE;
stTestAteqMappedIo.Write.CmdBit.bReadFIFO     := TRUE;
stTestAteqMappedIo.Write.CmdBit.bReadParams      := TRUE;
stTestAteqMappedIo.Write.CmdBit.bWriteParams     := TRUE;
stTestAteqMappedIo.Write.CmdBit.bResetFIFO           := TRUE;
stTestAteqMappedIo.Write.CmdBit.bReadInstrumentConfig := TRUE;
stTestAteqMappedIo.Write.CmdBit.bReadConfigMenuBits          := TRUE;
stTestAteqMappedIo.Write.CmdBit.bReadFunctionBits    := TRUE;
stTestAteqMappedIo.Write.CmdBit.bWriteExtMenu        := TRUE;
stTestAteqMappedIo.Write.CmdBit.bWriteFunctionBits   := TRUE;
stTestAteqMappedIo.Write.CmdBit.bReadProgramName     := TRUE;
stTestAteqMappedIo.Write.CmdBit.bWriteProgramName    := TRUE;
stTestAteqMappedIo.Write.CmdBit.bReadLastResult      := TRUE;

stTestAteqMappedIo.Write.ReservedOut1Byte[0] := 161;
stTestAteqMappedIo.Write.ReservedOut1Byte[1] := 162;
stTestAteqMappedIo.Write.ReservedOut1Byte[2] := 163;
stTestAteqMappedIo.Write.ReservedOut1Byte[3] := 164;

stTestAteqMappedIo.Write.nProgramNumber := 16#2211;
stTestAteqMappedIo.Write.nSpecialCycle := 16#4433;

FOR nIndex := 0 TO 21 DO
    stTestAteqMappedIo.Write.ReservedOut2Byte[nIndex] := 80 + nIndex;
END_FOR
FOR nIndex := 0 TO 127 DO
    stTestAteqMappedIo.Write.ExchangeZoneByte[nIndex] := 192 + nIndex;
END_FOR

//fbTestAteqComm(nDeviceIndex := nDeviceIndex, stRawIo := stTestAteqRawIo, stMappedIo := stTestAteqMappedIo);

AssertEquals_BYTE(255, stTestAteqRawIo.OutByte[0][0], 'CommandByte0 mismatch');
AssertEquals_BYTE(255, stTestAteqRawIo.OutByte[0][1], 'CommandByte1 mismatch');

AssertEquals_BYTE(161, stTestAteqRawIo.OutByte[0][2], 'ReservedOut1[0] mismatch');
AssertEquals_BYTE(162, stTestAteqRawIo.OutByte[0][3], 'ReservedOut1[1] mismatch');
AssertEquals_BYTE(163, stTestAteqRawIo.OutByte[0][4], 'ReservedOut1[2] mismatch');
AssertEquals_BYTE(164, stTestAteqRawIo.OutByte[0][5], 'ReservedOut1[3] mismatch');

AssertEquals_BYTE(16#22, stTestAteqRawIo.OutByte[0][6], 'ProgramSelect[LowByte] mismatch');
AssertEquals_BYTE(16#11, stTestAteqRawIo.OutByte[0][7], 'ProgramSelect[HighByte] mismatch');
AssertEquals_BYTE(16#44, stTestAteqRawIo.OutByte[0][8], 'SpecialCycle[LowByte] mismatch');
AssertEquals_BYTE(16#33, stTestAteqRawIo.OutByte[0][9], 'SpecialCycle[HighByte] mismatch');

FOR nIndex := 0 TO 21 DO
    AssertEquals_BYTE(80 + nIndex, stTestAteqRawIo.OutByte[0][10 + nIndex], CONCAT(CONCAT('ReservedOut2[', INT_TO_STRING(nIndex)), '] mismatch'));
END_FOR

FOR nIndex := 0 TO 127 DO
    AssertEquals_BYTE(192 + nIndex, stTestAteqRawIo.OutByte[(32 + nIndex) / 64][(32 + nIndex) MOD 64], CONCAT(CONCAT('ExchangeZone[', INT_TO_STRING(nIndex)), '] mismatch'));
END_FOR

TEST_FINISHED();]]></ST>
      </Implementation>
    </Method>
  </POU>
</TcPlcObject>