]]></Comment><BitSize>16</BitSize><BaseType>UINT</BaseType><Properties><Property><Name>TcAddressType</Name><Value>Input</Value></Property><Property><Name>TcVarGlobal</Name></Property></Properties><BitOffs>650714000</BitOffs></Symbol><Symbol><Name>GVL_MapEL6070.SlaveCount</Name><Comment><![CDATA[ Actual count OF EtherCAT slaves received	]]></Comment><BitSize>16</BitSize><BaseType>UINT</BaseType><Properties><Property><Name>TcAddressType</Name><Value>Input</Value></Property><Property><Name>TcVarGlobal</Name></Property></Properties><BitOffs>650714016</BitOffs></Symbol><Symbol><Name>GVL_MapEL6070.DevState</Name><BitSize>16</BitSize><BaseType>UINT</BaseType><Properties><Property><Name>TcAddressType</Name><Value>Input</Value></Property><Property><Name>TcVarGlobal</Name></Property></Properties><BitOffs>650714032</BitOffs></Symbol><Symbol><Name>GVL_MapEL6070.ChangeCount</Name><Comment><![CDATA[InfoData]]></Comment><BitSize>16</BitSize><BaseType>UINT</BaseType><Properties><Property><Name>TcAddressType</Name><Value>Input</Value></Property><Property><Name>TcVarGlobal</Name></Property></Properties><BitOffs>650714096</BitOffs></Symbol><Symbol><Name>GVL_MapEL6070.DevId</Name><BitSize>16</BitSize><BaseType>UINT</BaseType><Properties><Property><Name>TcAddressType</Name><Value>Input</Value></Property><Property><Name>TcVarGlobal</Name></Property></Properties><BitOffs>650714112</BitOffs></Symbol><Symbol><Name>GVL_MapEL6070.AmsNetId</Name><BitSize>48</BitSize><BaseType GUID="{18071995-0000-0000-0000-000000000041}">AMSNETID</BaseType><Properties><Property><Name>TcAddressType</Name><Value>Input</Value></Property><Property><Name>TcVarGlobal</Name></Property></Properties><BitOffs>650714128</BitOffs></Symbol><Symbol><Name>GVL_MapEL6070.CfgSlaveCount</Name><BitSize>16</BitSize><BaseType>UINT</BaseType><Properties><Property><Name>TcAddressType</Name><Value>Input</Value></Property><Property><Name>TcVarGlobal</Name></Property></Properties><BitOffs>650714176</BitOffs></Symbol></DataArea><DataArea