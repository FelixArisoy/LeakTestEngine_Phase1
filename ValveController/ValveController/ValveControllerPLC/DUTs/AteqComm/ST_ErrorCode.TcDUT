<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.15">
  <DUT Name="ST_ErrorCode" Id="{ca34406b-f405-4d37-a2b3-a9b3cb2956fb}">
    <Declaration><![CDATA[TYPE ST_ErrorCode :
STRUCT
	
	 (* Byte 0 - 02h *)
    bReset                  : BOOL; // Bit 0
    bStart                  : BOOL; // Bit 1
    bSpecialCycle           : BOOL; // Bit 2
    bProgramSelect          : BOOL; // Bit 3
    bReadFIFO               : BOOL; // Bit 4
    bReadParams             : BOOL; // Bit 5
    bWriteParams            : BOOL; // Bit 6
    bResetFIFO              : BOOL; // Bit 7

    (* Byte 1 - 03h *)
    bReadConfig             : BOOL; // Bit 0
    bReadExtMenu            : BOOL; // Bit 1
    bReadFunctionBits       : BOOL; // Bit 2
    bWriteExtMenu           : BOOL; // Bit 3
    bWriteFunctionBits      : BOOL; // Bit 4
    bReadProgramName        : BOOL; // Bit 5
    bWriteProgramName       : BOOL; // Bit 6
    bReadLastResult         : BOOL; // Bit 7
	
END_STRUCT
END_TYPE
]]></Declaration>
  </DUT>
</TcPlcObject>