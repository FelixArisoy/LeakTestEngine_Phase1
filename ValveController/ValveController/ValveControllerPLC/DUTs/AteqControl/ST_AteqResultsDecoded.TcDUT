<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.15">
  <DUT Name="ST_AteqResultsDecoded" Id="{76dbbe4c-3efb-4e8f-98ea-bd8ac81cd241}">
    <Declaration><![CDATA[TYPE ST_AteqResultsDecoded :
STRUCT
	
    nProgramNumber      : WORD;
    nTestType           : WORD;
    nRelayImage         : WORD;  // Original raw word

    // Relay image decoded bits
    bPassPart           : BOOL;  // Bit 0 = 1: pass
    bFailMaxFlow        : BOOL;  // Bit 1 = 1: fail (max)
    bFailMinFlow        : BOOL;  // Bit 2 = 1: fail (min)
    bAlarm              : BOOL;  // Bit 3 = 1: alarm
    bUnused4            : BOOL;  // Bit 4
    bReserved5          : BOOL;  // Bit 5
    bUnused6            : BOOL;  // Bit 6
    bUnused7            : BOOL;  // Bit 7

    nAlarmCode          : WORD;

    fPressure          	: REAL;
    nPressureUnitCode   : DWORD;

    fLeak              	: REAL;
    nLeakUnitCode       : DWORD;

    fPiezo2Pressure    	: REAL;
    nPiezo2UnitCode     : DWORD;

    fTestCheckResult    : REAL;
    nTestCheckUnitCode  : DWORD;

    fLargeLeak         	: REAL;
    nLargeLeakUnitCode  : DWORD;

    fPaLeakResult      	: REAL;

	aUnused             : ARRAY[27..36] OF WORD; // Word 27-36
	
    fAtmosphere_hPa    	: REAL;
    fTemperature_C     	: REAL;

   // dtTimestamp       : DT;
	
END_STRUCT
END_TYPE

]]></Declaration>
  </DUT>
</TcPlcObject>