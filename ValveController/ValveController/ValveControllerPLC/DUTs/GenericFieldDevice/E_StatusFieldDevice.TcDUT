  <DUT Name="E_StatusFieldDevice" Id="{13d5fbd0-ecaa-4ed6-aa3a-4a7f4b256a0b}">
    <Declaration><![CDATA[{attribute 'qualified_only'}
{attribute 'strict'}
TYPE E_StatusFieldDevice :
(
 	OK,
    COMM_ERROR,
    SHORT_CIRCUIT,
    OPEN_CIRCUIT,
	POWER_NORMAL, // State of power supply to the device normal
	POWER_UNDER_VOLTAGE, // State of power supply to the device abnormal
