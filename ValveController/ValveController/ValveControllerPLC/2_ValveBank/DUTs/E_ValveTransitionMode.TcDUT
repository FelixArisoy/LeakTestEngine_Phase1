<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.15">
  <DUT Name="E_ValveTransitionMode" Id="{f1383028-be09-491a-9f9b-ef4a350deea6}">
    <Declaration><![CDATA[TYPE E_ValveTransitionMode :
(
    Immediate,			// No Condition required, immediate transition
    HoldPrevious_ON,	// OBC Open next valve Before Closing previous
    HoldNext_OFF		// CBO Close previous Before Open next valve
);
END_TYPE
]]></Declaration>
  </DUT>
</TcPlcObject>