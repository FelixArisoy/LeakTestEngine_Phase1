<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <POU Name="FB_ValveMaskHandlerOld" Id="{912e2ede-3ff2-4af3-9484-d20fa1177a89}" SpecialFunc="None">
    <Declaration><![CDATA[FUNCTION_BLOCK FB_ValveMaskHandlerOld
VAR_INPUT
    abValveMaskSetRequest : ARRAY[0..GVL_AteqConfig.nMaxDeviceCount - 1] OF BOOL; // From ATEQ handlers
    aValveMaskSteps : ARRAY[0..GVL_AteqConfig.nMaxTestSteps - 1] OF ST_ValveMaskStep;
    aAteqValveMaps : ARRAY[0..GVL_AteqConfig.nMaxDeviceCount - 1] OF ST_AteqValveMap;
    aAteqValveMasks : ARRAY[0..GVL_AteqConfig.nMaxDeviceCount - 1] OF ARRAY[0..3] OF DWORD; // Up to 128 valves per ATEQ
END_VAR

VAR_OUTPUT
    bValveMaskSetDone : BOOL;
    aCurrentValveMask : ARRAY[0..3] OF DWORD; // Composite output mask across up to 4 valve banks (128 valves)
    nCurrentSeqStepIndex : INT;
END_VAR

VAR
    bStepReady : BOOL;
    tTransitionHold : TON;
    eState : (IDLE, TRANSITION_HOLD, APPLY_FINAL);
    aPreviousMask : ARRAY[0..3] OF DWORD;
    aIntermediateMask : ARRAY[0..3] OF DWORD;
    i : UINT;
END_VAR


]]></Declaration>
    <Implementation>
      <ST><![CDATA[// Step readiness check 
bStepReady := TRUE;
FOR i := 0 TO GVL_AteqConfig.nMaxDeviceCount - 1 DO
    IF (aValveMaskSteps[nCurrentSeqStepIndex].nExpectedDoneMask AND SHL(1, i)) <> 0 THEN
        IF NOT abValveMaskSetRequest[i] THEN
            bStepReady := FALSE;
            EXIT;
        END_IF
    END_IF
END_FOR

CASE eState OF
    IDLE:
        IF bStepReady THEN
            aPreviousMask := aCurrentValveMask;
            CASE aValveMaskSteps[nCurrentSeqStepIndex].eTransitionMode OF

                HoldPrevious_ON: // OBC Open Next before Closing Previous
                    aIntermediateMask := M_ComposeValveMask(aAteqValveMaps, aAteqValveMasks);
                    FOR i := 0 TO 3 DO
                        aCurrentValveMask[i] := aPreviousMask[i] OR aIntermediateMask[i];
                    END_FOR
                    eState := TRANSITION_HOLD;
                   
                HoldNext_OFF: // CBO Close Previous before Openning Next
                    aIntermediateMask := M_ComposeValveMask(aAteqValveMaps, aAteqValveMasks);
                    FOR i := 0 TO 3 DO
                        aCurrentValveMask[i] := aPreviousMask[i] AND NOT aIntermediateMask[i];
                    END_FOR
                    eState := TRANSITION_HOLD;
                    
                Immediate:
                    aCurrentValveMask := M_ComposeValveMask(aAteqValveMaps, aAteqValveMasks);
                    bValveMaskSetDone := TRUE;
                    nCurrentSeqStepIndex := nCurrentSeqStepIndex + 1;
            END_CASE
        END_IF

    TRANSITION_HOLD:
       tTransitionHold(IN := TRUE, PT := aValveMaskSteps[nCurrentSeqStepIndex].tTransitionHoldTime);

        IF tTransitionHold.Q THEN
            eState := APPLY_FINAL;
            tTransitionHold(IN := FALSE);
        END_IF

    APPLY_FINAL:
        aCurrentValveMask := M_ComposeValveMask(aAteqValveMaps, aAteqValveMasks);
        bValveMaskSetDone := TRUE;
        nCurrentSeqStepIndex := nCurrentSeqStepIndex + 1;
        eState := IDLE;
END_CASE
]]></ST>
    </Implementation>
    <Method Name="M_ComposeValveMask" Id="{02ff877c-ba6f-43fd-98c2-2957bc2319d2}">
      <Declaration><![CDATA[METHOD PRIVATE M_ComposeValveMask : ARRAY[0..3] OF DWORD
VAR_INPUT
    aValveMaps : ARRAY[0..GVL_AteqConfig.nMaxDeviceCount - 1] OF ST_AteqValveMap;
    aMasks     : ARRAY[0..GVL_AteqConfig.nMaxDeviceCount - 1] OF ARRAY[0..3] OF DWORD;
END_VAR
VAR
    result : ARRAY[0..3] OF DWORD := [0, 0, 0, 0];
    idx, bitOffset, wordIndex : UINT;
    shiftedMask : ARRAY[0..3] OF DWORD;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[
FOR idx := 0 TO GVL_AteqConfig.nMaxDeviceCount - 1 DO
    FOR wordIndex := 0 TO 3 DO
        bitOffset := aValveMaps[idx].nValveStartIndex;
        IF bitOffset < 32 THEN
            result[0] := result[0] OR SHL(aMasks[idx][wordIndex], bitOffset);
        ELSIF bitOffset < 64 THEN
            result[1] := result[1] OR SHL(aMasks[idx][wordIndex], bitOffset - 32);
        ELSIF bitOffset < 96 THEN
            result[2] := result[2] OR SHL(aMasks[idx][wordIndex], bitOffset - 64);
        ELSE
            result[3] := result[3] OR SHL(aMasks[idx][wordIndex], bitOffset - 96);
        END_IF
    END_FOR
END_FOR
M_ComposeValveMask := result;]]></ST>
      </Implementation>
    </Method>
  </POU>
</TcPlcObject>