    <Method Name="mMapInput" Id="{94ae9230-e4e6-4b89-b299-6e4cade93c2c}">
      <Declaration><![CDATA[METHOD mMapInput
VAR

	nIndex1 : INT;

	byEcho0, byEcho1       : BYTE;
    byError0, byError1     : BYTE;
    byResult0, byResult1   : BYTE;

	anPressureCurValueBuffer 	: ARRAY [0..3] OF BYTE;
	anPressureUnitCodeBuffer	: ARRAY [0..3] OF BYTE;	
	anLeakCurValueBuffer 		: ARRAY [0..3] OF BYTE;		
	anLeakUnitCodeBuffer		: ARRAY [0..3] OF BYTE;
// temporary DWORD variables for reconstruction
    nPressureCurValueBuffer      : DWORD;
    nPressureUnitCodeBuffer      : DWORD;
    nLeakCurValueBuffer          : DWORD;
    nLeakUnitCodeBuffer          : DWORD;
	
END_VAR

]]></Declaration>
      <Implementation>
        <ST><![CDATA[
// Direct read from stAteqRawIo
byEcho0     := stRawIoBuf.anInput[0][0];  // 00h
byEcho1     := stRawIoBuf.anInput[0][1];  // 01h
byError0    := stRawIoBuf.anInput[0][2];  // 02h
byError1    := stRawIoBuf.anInput[0][3];  // 03h
byResult0   := stRawIoBuf.anInput[0][12]; // 0Ch
byResult1   := stRawIoBuf.anInput[0][13]; // 0Dh

// Copy bytes into buffers
stMappedIoBuf.stRead.anEcho[0] 		:= byEcho0;
stMappedIoBuf.stRead.anEcho[1] 		:= byEcho1;
stMappedIoBuf.stRead.anErrorCode[0] 	:= byError0;
stMappedIoBuf.stRead.anErrorCode[1] 	:= byError1;

// -------- 00h - 01h: Decode Echo Status --------
stMappedIoBuf.stRead.stEcho.bReset             := (byEcho0 AND 16#01) <> 0;
stMappedIoBuf.stRead.stEcho.bStart             := (byEcho0 AND 16#02) <> 0;
stMappedIoBuf.stRead.stEcho.bSpecialCycle      := (byEcho0 AND 16#04) <> 0;
stMappedIoBuf.stRead.stEcho.bProgramSelect     := (byEcho0 AND 16#08) <> 0;
stMappedIoBuf.stRead.stEcho.bReadFIFO          := (byEcho0 AND 16#10) <> 0;
stMappedIoBuf.stRead.stEcho.bReadParams        := (byEcho0 AND 16#20) <> 0;
stMappedIoBuf.stRead.stEcho.bWriteParams       := (byEcho0 AND 16#40) <> 0;
stMappedIoBuf.stRead.stEcho.bResetFIFO         := (byEcho0 AND 16#80) <> 0;

stMappedIoBuf.stRead.stEcho.bReadInstrumentConfig        := (byEcho1 AND 16#01) <> 0;
stMappedIoBuf.stRead.stEcho.bReadConfigMenuBits       := (byEcho1 AND 16#02) <> 0;
stMappedIoBuf.stRead.stEcho.bReadFunctionBits  := (byEcho1 AND 16#04) <> 0;
stMappedIoBuf.stRead.stEcho.bWriteExtMenu      := (byEcho1 AND 16#08) <> 0;
stMappedIoBuf.stRead.stEcho.bWriteFunctionBits := (byEcho1 AND 16#10) <> 0;
stMappedIoBuf.stRead.stEcho.bReadProgramName   := (byEcho1 AND 16#20) <> 0;
stMappedIoBuf.stRead.stEcho.bWriteProgramName  := (byEcho1 AND 16#40) <> 0;
stMappedIoBuf.stRead.stEcho.bReadLastResult    := (byEcho1 AND 16#80) <> 0;

// -------- 02h - 03h: Decode Error Codes --------
stMappedIoBuf.stRead.stErrorCode.bReset             := (byError0 AND 16#01) <> 0;
stMappedIoBuf.stRead.stErrorCode.bStart             := (byError0 AND 16#02) <> 0;
stMappedIoBuf.stRead.stErrorCode.bSpecialCycle      := (byError0 AND 16#04) <> 0;
stMappedIoBuf.stRead.stErrorCode.bProgramSelect     := (byError0 AND 16#08) <> 0;
stMappedIoBuf.stRead.stErrorCode.bReadFIFO          := (byError0 AND 16#10) <> 0;
stMappedIoBuf.stRead.stErrorCode.bReadParams        := (byError0 AND 16#20) <> 0;
stMappedIoBuf.stRead.stErrorCode.bWriteParams       := (byError0 AND 16#40) <> 0;
stMappedIoBuf.stRead.stErrorCode.bResetFIFO         := (byError0 AND 16#80) <> 0;

stMappedIoBuf.stRead.stErrorCode.bReadInstrumentConfig        := (byError1 AND 16#01) <> 0;
stMappedIoBuf.stRead.stErrorCode.bReadConfigMenuBits       := (byError1 AND 16#02) <> 0;
stMappedIoBuf.stRead.stErrorCode.bReadFunctionBits  := (byError1 AND 16#04) <> 0;
stMappedIoBuf.stRead.stErrorCode.bWriteExtMenu      := (byError1 AND 16#08) <> 0;
stMappedIoBuf.stRead.stErrorCode.bWriteFunctionBits := (byError1 AND 16#10) <> 0;
stMappedIoBuf.stRead.stErrorCode.bReadProgramName   := (byError1 AND 16#20) <> 0;
stMappedIoBuf.stRead.stErrorCode.bWriteProgramName  := (byError1 AND 16#40) <> 0;
stMappedIoBuf.stRead.stErrorCode.bReadLastResult    := (byError1 AND 16#80) <> 0;


stMappedIoBuf.stRead.anReserved[0]	:= stRawIoBuf.anInput[0][4];
stMappedIoBuf.stRead.anReserved[1]	:= stRawIoBuf.anInput[0][5];

	CASE  GVL_AteqConfig.eDeviceEndianSetTo OF
		E_AteqEndianType.LittleEndian: // Little Endian
		// Parse WORDs from bytes
		stMappedIoBuf.stRead.nProgramInUse		:= SHL(BYTE_TO_WORD(stRawIoBuf.anInput[0][6]), 8) OR BYTE_TO_WORD(stRawIoBuf.anInput[0][7]);
		stMappedIoBuf.stRead.nResultsInFifo	:= SHL(BYTE_TO_WORD(stRawIoBuf.anInput[0][8]), 8) OR BYTE_TO_WORD(stRawIoBuf.anInput[0][9]);
		stMappedIoBuf.stRead.nTestType			:= SHL(BYTE_TO_WORD(stRawIoBuf.anInput[0][10]), 8) OR BYTE_TO_WORD(stRawIoBuf.anInput[0][11]);
		stMappedIoBuf.stRead.nProgramStep		:= SHL(BYTE_TO_WORD(stRawIoBuf.anInput[0][14]), 8) OR BYTE_TO_WORD(stRawIoBuf.anInput[0][15]);

		E_AteqEndianType.BigEndian: // Big Endian
		stMappedIoBuf.stRead.nProgramInUse		:= BYTE_TO_WORD(stRawIoBuf.anInput[0][6]) 	OR SHL(BYTE_TO_WORD(stRawIoBuf.anInput[0][7]), 8);
		stMappedIoBuf.stRead.nResultsInFifo	:= BYTE_TO_WORD(stRawIoBuf.anInput[0][8]) 	OR SHL(BYTE_TO_WORD(stRawIoBuf.anInput[0][9]), 8);
		stMappedIoBuf.stRead.nTestType			:= BYTE_TO_WORD(stRawIoBuf.anInput[0][10]) OR SHL(BYTE_TO_WORD(stRawIoBuf.anInput[0][11]), 8);
		stMappedIoBuf.stRead.nProgramStep		:= BYTE_TO_WORD(stRawIoBuf.anInput[0][14]) OR SHL(BYTE_TO_WORD(stRawIoBuf.anInput[0][15]), 8);
	END_CASE
		

// -------- 0Ch - 0Dh: Decode Real-Time Test Results --------
stMappedIoBuf.stRead.stRealtimeTestResults.bPass            := (byResult0 AND 16#01) <> 0;
stMappedIoBuf.stRead.stRealtimeTestResults.bFailPart        := (byResult0 AND 16#02) <> 0;
stMappedIoBuf.stRead.stRealtimeTestResults.bFailRef         := (byResult0 AND 16#04) <> 0;
stMappedIoBuf.stRead.stRealtimeTestResults.bAlarm           := (byResult0 AND 16#08) <> 0;
stMappedIoBuf.stRead.stRealtimeTestResults.bPressureEror     := (byResult0 AND 16#10) <> 0;
stMappedIoBuf.stRead.stRealtimeTestResults.bCycleEnd        := (byResult0 AND 16#20) <> 0;
stMappedIoBuf.stRead.stRealtimeTestResults.bRecoverable     := (byResult0 AND 16#40) <> 0;
stMappedIoBuf.stRead.stRealtimeTestResults.bCalibEror        := (byResult0 AND 16#80) <> 0;

stMappedIoBuf.stRead.stRealtimeTestResults.bCalibCheckEror   := (byResult1 AND 16#01) <> 0;
stMappedIoBuf.stRead.stRealtimeTestResults.bATRFault        := (byResult1 AND 16#02) <> 0;



// Assign the 4 bytes from the raw PressureCurValue input
anPressureCurValueBuffer [0] := stRawIoBuf.anInput[0][16];
anPressureCurValueBuffer [1] :=	stRawIoBuf.anInput[0][17];
anPressureCurValueBuffer [2] :=	stRawIoBuf.anInput[0][18];
anPressureCurValueBuffer [3] :=	stRawIoBuf.anInput[0][19];

anPressureUnitCodeBuffer [0] := stRawIoBuf.anInput[0][20];
anPressureUnitCodeBuffer [1] :=	stRawIoBuf.anInput[0][21];
anPressureUnitCodeBuffer [2] :=	stRawIoBuf.anInput[0][22];
anPressureUnitCodeBuffer [3] :=	stRawIoBuf.anInput[0][23];

anLeakCurValueBuffer [0] := stRawIoBuf.anInput[0][24];
anLeakCurValueBuffer [1] :=	stRawIoBuf.anInput[0][25];
anLeakCurValueBuffer [2] :=	stRawIoBuf.anInput[0][26];
anLeakCurValueBuffer [3] :=	stRawIoBuf.anInput[0][27];

anLeakUnitCodeBuffer [0] := stRawIoBuf.anInput[0][28];
anLeakUnitCodeBuffer [1] :=	stRawIoBuf.anInput[0][29];
anLeakUnitCodeBuffer [2] :=	stRawIoBuf.anInput[0][30];
anLeakUnitCodeBuffer [3] :=	stRawIoBuf.anInput[0][31];

// Copy into REAL and DWORD vars from Buffer adr to Destination Adr of the ST_AteqInRead
// --- Endianness-aware conversion for 4-byte values (DWORD and REAL) ---
CASE GVL_AteqConfig.eDeviceEndianSetTo OF
    E_AteqEndianType.BigEndian: // ATEQ sends LSB first (Byte0, Byte1, Byte2, Byte3)
        // Reconstruct DWORDs from buffers for Little Endian
        nPressureCurValueBuffer := 
            BYTE_TO_DWORD(anPressureCurValueBuffer[0]) 		OR
            SHL(BYTE_TO_DWORD(anPressureCurValueBuffer[1]), 8) 	OR
            SHL(BYTE_TO_DWORD(anPressureCurValueBuffer[2]), 16) OR
            SHL(BYTE_TO_DWORD(anPressureCurValueBuffer[3]), 24);

        nPressureUnitCodeBuffer := 
            BYTE_TO_DWORD(anPressureUnitCodeBuffer[0]) 		OR
            SHL(BYTE_TO_DWORD(anPressureUnitCodeBuffer[1]), 8) 	OR
            SHL(BYTE_TO_DWORD(anPressureUnitCodeBuffer[2]), 16) OR
            SHL(BYTE_TO_DWORD(anPressureUnitCodeBuffer[3]), 24);

        nLeakCurValueBuffer := 
            BYTE_TO_DWORD(anLeakCurValueBuffer[0]) 		OR
            SHL(BYTE_TO_DWORD(anLeakCurValueBuffer[1]), 8) 	OR
            SHL(BYTE_TO_DWORD(anLeakCurValueBuffer[2]), 16) OR
            SHL(BYTE_TO_DWORD(anLeakCurValueBuffer[3]), 24);

        nLeakUnitCodeBuffer := 
            BYTE_TO_DWORD(anLeakUnitCodeBuffer[0]) 		OR
            SHL(BYTE_TO_DWORD(anLeakUnitCodeBuffer[1]), 8) 	OR
            SHL(BYTE_TO_DWORD(anLeakUnitCodeBuffer[2]), 16) OR
            SHL(BYTE_TO_DWORD(anLeakUnitCodeBuffer[3]), 24);

    E_AteqEndianType.LittleEndian: // ATEQ sends MSB first (Byte3, Byte2, Byte1, Byte0)
        // Reconstruct DWORDs from buffers for Big Endian
        nPressureCurValueBuffer := 
            SHL(BYTE_TO_DWORD(anPressureCurValueBuffer[0]), 24) OR
            SHL(BYTE_TO_DWORD(anPressureCurValueBuffer[1]), 16) OR
            SHL(BYTE_TO_DWORD(anPressureCurValueBuffer[2]), 8) 	OR
            BYTE_TO_DWORD(anPressureCurValueBuffer[3]);

        nPressureUnitCodeBuffer := 
            SHL(BYTE_TO_DWORD(anPressureUnitCodeBuffer[0]), 24) OR
            SHL(BYTE_TO_DWORD(anPressureUnitCodeBuffer[1]), 16) OR
            SHL(BYTE_TO_DWORD(anPressureUnitCodeBuffer[2]), 8) 	OR
            BYTE_TO_DWORD(anPressureUnitCodeBuffer[3]);

        nLeakCurValueBuffer := 
            SHL(BYTE_TO_DWORD(anLeakCurValueBuffer[0]), 24) OR
            SHL(BYTE_TO_DWORD(anLeakCurValueBuffer[1]), 16) OR
            SHL(BYTE_TO_DWORD(anLeakCurValueBuffer[2]), 8) 	OR
            BYTE_TO_DWORD(anLeakCurValueBuffer[3]);

        nLeakUnitCodeBuffer := 
            SHL(BYTE_TO_DWORD(anLeakUnitCodeBuffer[0]), 24) OR
            SHL(BYTE_TO_DWORD(anLeakUnitCodeBuffer[1]), 16) OR
            SHL(BYTE_TO_DWORD(anLeakUnitCodeBuffer[2]), 8) 	OR
            BYTE_TO_DWORD(anLeakUnitCodeBuffer[3]);
END_CASE

// Assign unit codes directly without scaling
stMappedIoBuf.stRead.nPressureUnitCode := nPressureUnitCodeBuffer;  
stMappedIoBuf.stRead.nLeakUnitCode     := nLeakUnitCodeBuffer;      

// Convert raw DWORD measurement values to REAL and scale
stMappedIoBuf.stRead.nPressureCurValue := DWORD_TO_REAL(nPressureCurValueBuffer) / 1000;
stMappedIoBuf.stRead.nLeakCurValue     := DWORD_TO_REAL(nLeakCurValueBuffer) / 10000;
;

// Exchange Zone: 128 bytes (20h – 9Fh = byte 33 to 160)

//################ Need byte module break
	FOR nIndex1 := 0 TO 127 DO
		stMappedIoBuf.stRead.anExchangeZone[nIndex1] := stRawIoBuf.anInput[(32 + nIndex1) / 64][(32 + nIndex1) MOD 64];
	END_FOR;
]]></ST>
      </Implementation>
    </Method>
    <Method Name="mMapOutput" Id="{51d42db0-b220-416b-bd6a-3a29c1b8bffe}">
      <Declaration><![CDATA[METHOD mMapOutput
VAR
	nIndex1	: INT;
	nIndex2 : INT;
	
	nCommand0 : BYTE;
	nCommand1 : BYTE; 
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[// ----- Build byte 0 (00h - Command Byte 0) -----

IF stMappedIoBuf.stWrite.stCommands.bReset THEN
    nCommand0 := nCommand0 OR 16#01;
END_IF;
IF stMappedIoBuf.stWrite.stCommands.bStart THEN
    nCommand0 := nCommand0 OR 16#02;
END_IF;
IF stMappedIoBuf.stWrite.stCommands.bSpecialCycle THEN
    nCommand0 := nCommand0 OR 16#04;
END_IF;
IF stMappedIoBuf.stWrite.stCommands.bProgramSelect THEN
    nCommand0 := nCommand0 OR 16#08;
END_IF;
IF stMappedIoBuf.stWrite.stCommands.bReadFIFO THEN
    nCommand0 := nCommand0 OR 16#10;
END_IF;
IF stMappedIoBuf.stWrite.stCommands.bReadParams THEN
    nCommand0 := nCommand0 OR 16#20;
END_IF;
IF stMappedIoBuf.stWrite.stCommands.bWriteParams THEN
    nCommand0 := nCommand0 OR 16#40;
END_IF;
IF stMappedIoBuf.stWrite.stCommands.bResetFIFO THEN
    nCommand0 := nCommand0 OR 16#80;
END_IF;

// ----- Build byte 1 (01h - Command Byte 1) -----
IF stMappedIoBuf.stWrite.stCommands.bReadInstrumentConfig THEN
    nCommand1 := nCommand1 OR 16#01;
END_IF;
IF stMappedIoBuf.stWrite.stCommands.bReadConfigMenuBits THEN
    nCommand1 := nCommand1 OR 16#02;
END_IF;
IF stMappedIoBuf.stWrite.stCommands.bReadFunctionBits THEN
    nCommand1 := nCommand1 OR 16#04;
END_IF;
IF stMappedIoBuf.stWrite.stCommands.bWriteExtMenu THEN
    nCommand1 := nCommand1 OR 16#08;
END_IF;
IF stMappedIoBuf.stWrite.stCommands.bWriteFunctionBits THEN
    nCommand1 := nCommand1 OR 16#10;
END_IF;
IF stMappedIoBuf.stWrite.stCommands.bReadProgramName THEN
    nCommand1 := nCommand1 OR 16#20;
END_IF;
IF stMappedIoBuf.stWrite.stCommands.bWriteProgramName THEN
    nCommand1 := nCommand1 OR 16#40;
END_IF;
IF stMappedIoBuf.stWrite.stCommands.bReadLastResult THEN
    nCommand1 := nCommand1 OR 16#80;
END_IF;

// Assign to MappedIO
stMappedIoBuf.stWrite.anCommands[0] := nCommand0;
stMappedIoBuf.stWrite.anCommands[1] := nCommand1;

// Map mappedIO to raw IO
stRawIoBuf.anOutput[0][0] := nCommand0;
stRawIoBuf.anOutput[0][1] := nCommand1;

// Reserved output bytes
stRawIoBuf.anOutput[0][2] := stMappedIoBuf.stWrite.anReservedOut1[0];
stRawIoBuf.anOutput[0][3] := stMappedIoBuf.stWrite.anReservedOut1[1];
stRawIoBuf.anOutput[0][4] := stMappedIoBuf.stWrite.anReservedOut1[2];
stRawIoBuf.anOutput[0][5] := stMappedIoBuf.stWrite.anReservedOut1[3];

CASE  GVL_AteqConfig.eDeviceEndianSetTo OF
	E_AteqEndianType.BigEndian: //little-endian
	// Program Select
	stRawIoBuf.anOutput[0][6] := WORD_TO_BYTE(stMappedIoBuf.stWrite.nProgramNumber AND 16#00FF);
	stRawIoBuf.anOutput[0][7] := WORD_TO_BYTE(SHR(stMappedIoBuf.stWrite.nProgramNumber, 8));
	// Special Cycle
	stRawIoBuf.anOutput[0][8] := WORD_TO_BYTE(stMappedIoBuf.stWrite.nSpecialCycle AND 16#00FF);
	stRawIoBuf.anOutput[0][9] := WORD_TO_BYTE(SHR(stMappedIoBuf.stWrite.nSpecialCycle, 8));
	
	E_AteqEndianType.LittleEndian: // big-endian
	// Program Select 
	stRawIoBuf.anOutput[0][6] := WORD_TO_BYTE(SHR(stMappedIoBuf.stWrite.nProgramNumber, 8));
	stRawIoBuf.anOutput[0][7] := WORD_TO_BYTE(stMappedIoBuf.stWrite.nProgramNumber AND 16#00FF);
	// Special Cycle
	stRawIoBuf.anOutput[0][8] := WORD_TO_BYTE(SHR(stMappedIoBuf.stWrite.nSpecialCycle, 8) );
	stRawIoBuf.anOutput[0][9] := WORD_TO_BYTE(stMappedIoBuf.stWrite.nSpecialCycle AND 16#00FF);
END_CASE


// Copy ReservedOut2
FOR nIndex1 := 0 TO 21 DO
    stRawIoBuf.anOutput[0][10 + nIndex1] := stMappedIoBuf.stWrite.anReservedOut2[nIndex1];
END_FOR;

// Exchange Zone (byte-matrix to 2D array)
FOR nIndex1 := 0 TO 127 DO
    stRawIoBuf.anOutput[(32 + nIndex1) / 64][(32 + nIndex1) MOD 64] := stMappedIoBuf.stWrite.anExchangeZone[nIndex1];
END_FOR;
]]></ST>
      </Implementation>
    </Method>
    <Method Name="mParamRead" Id="{e5267fc8-c940-466e-9918-6092a897a7f1}">
      <Declaration><![CDATA[METHOD mParamRead : E_AteqHandshakeSteps
VAR 
	bReadParamsComplete: BOOL;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[(*
// USED as manual Method call only
// use later, its a template

	fbCmdHandler(
					bCmdEcho    	:= stIo.stRead.stEcho.bReadParams,
    				bCmdError   	:= stIo.stRead.stErrorCode.bReadParams,
					bCmdTrigger 	:= stIo.stWrite.stCommands.bReadParameters,
					stIo_Ref		:= StIo,
					eStatus			=> M_ParamRead
);

//////////////////// DEBUG HERE /////////////////////////

		CASE M_ParamRead OF
			CMD_IDLE:
				IF NOT bReadParamsComplete THEN
					stIo.stWrite.stCommands.bReadParameters := TRUE; 
				END_IF
			CMD_DONE:
                bReadParamsComplete	:= TRUE;
				
        	CMD_FAIL:
            	Do Something; // Ateq comm failled after retry atempts

        END_CASE;

	IF bReadParamsComplete AND M_ParamRead = CMD_IDLE THEN
		; // Return here
	END_IF
*)]]></ST>
      </Implementation>
    </Method>
    <Method Name="mParamWrite" Id="{efef9bf2-d12a-4715-8734-c95ea8380a79}">
      <Declaration><![CDATA[METHOD mParamWrite : E_AteqHandshakeSteps
VAR 
	bWriteParamsComplete: BOOL;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[(*
// USED as manual Method call only
// use later, its a template. Excahange Zone needs to be filled. Follow Ateq Fieldbus Manual

	fbCmdHandler(
					bCmdEcho    	:= stIo.stRead.stEcho.bWriteParams,
    				bCmdError   	:= stIo.stRead.stErrorCode.bWriteParams,
					bCmdTrigger 	:= stIo.stWrite.stCommands.bWriteParams,
					stIo_Ref		:= StIo,
					eStatus			=> M_ParamWrite
);

//////////////////// DEBUG HERE /////////////////////////

		CASE M_ParamWrite OF
			CMD_IDLE:
				IF NOT bWriteParamsComplete THEN
					stIo.stWrite.stCommands.bWriteParams := TRUE; 
				END_IF
			CMD_DONE:
                bWriteParamsComplete	:= TRUE;
				
        	CMD_FAIL:
            	Do Something; // Ateq comm failled after retry atempts

        END_CASE;

	IF bWriteParamsComplete AND M_ParamWrite = CMD_IDLE THEN
		; // Return here
	END_IF
*)]]></ST>
      </Implementation>
    </Method>
    <Method Name="mPrgInternalSteps" Id="{3018ab2e-77fc-46ae-91da-718a64d69d9e}">
      <Declaration><![CDATA[METHOD mPrgInternalSteps : E_AteqStepsTable
VAR_INPUT
	nProgramStep : WORD;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[CASE nProgramStep OF
    0:        mPrgInternalSteps := E_AteqStepsTable.PreFill;
    1:        mPrgInternalSteps := E_AteqStepsTable.PreDump;
    4:        mPrgInternalSteps := E_AteqStepsTable.Fill;
    5:        mPrgInternalSteps := E_AteqStepsTable.Stabilization;
    6:        mPrgInternalSteps := E_AteqStepsTable.Test;
    7:        mPrgInternalSteps := E_AteqStepsTable.Dump;
    65535:    mPrgInternalSteps := E_AteqStepsTable.NoStepInProgress;
ELSE
    mPrgInternalSteps := E_AteqStepsTable.NoStepInProgress;
END_CASE]]></ST>
      </Implementation>
    </Method>
    <Method Name="mPrgSelect" Id="{3f180883-986e-4f1d-b18a-91a389fa3ca6}">
      <Declaration><![CDATA[METHOD mPrgSelect : E_AteqHandshakeSteps
VAR

END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[
stMappedIoBuf.stWrite.nProgramNumber := nProgramNumberToRun; // Sets the program number register
fbCmdHandler.pCmdTrigger := stMappedIoBuf.stWrite.stCommands.bProgramSelect;

	fbCmdHandler(
   					bCmdEcho    			:= stMappedIoBuf.stRead.stEcho.bProgramSelect,
    				bCmdError   			:= stMappedIoBuf.stRead.stErrorCode.bProgramSelect,
					stIo_Ref				:= stMappedIoBuf,
					eStatesAteqHandshake	=> mPrgSelect
);
	
	CASE mPrgSelect OF
		CMD_IDLE:
			IF NOT bProgramSelectComplete THEN
			stMappedIoBuf.stWrite.stCommands.bProgramSelect := TRUE;
			END_IF
				
		CMD_DONE:
			bProgramSelectComplete := TRUE;
				
		CMD_FAIL:
			eErrorFlags := E_AteqControlErrorFlags.ProgramSelectFail;
			// Add manual call Faults. Create STRUCT for HMI
	END_CASE;
]]></ST>
      </Implementation>
    </Method>
    <Method Name="mPrgSeq" Id="{470ae35c-cda6-49a5-a2ba-29d25da98e8a}">
      <Declaration><![CDATA[METHOD mPrgSeq
VAR   
	fbR_TRIG_RunSequence 			: R_TRIG;
	fbR_TRIG_AutoSeqResetRequest 	: R_TRIG;
	
	eStatesAteqHandshake         	: E_AteqHandshakeSteps;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[//	SEQUENCE TMEOUT
//############################################################################################
// SEQ start requested but didnot start check 
bDeviceReady := stMappedIoBuf.stRead.stRealtimeTestResults.bCycleEnd;

IF fbR_TRIG_RunSequence.Q AND
	eProgramSeqSteps <> SEQ_TEST_DONE AND 
	eProgramSeqSteps <> SEQ_ERROR AND 
	eProgramSeqSteps <> SEQ_TIMEOUT THEN
	
	tSeqTimeout(IN := TRUE, PT := GVL_AteqConfig.tAutoSeqTimeout); 
	IF tSeqTimeout.Q THEN
		eProgramSeqSteps := E_AteqProgramSeqSteps.SEQ_TIMEOUT;
	END_IF 
END_IF

//ALWAYS call the timer
tSeqTimeout(IN := tSeqTimeout.IN, PT := tSeqTimeout.PT);

//	SEQUENCE RESET REQUEST
//############################################################################################
		fbR_TRIG_AutoSeqResetRequest(CLK := bProgramSeqResetRequest);
		IF fbR_TRIG_AutoSeqResetRequest.Q THEN
			bProgramSeqResetRequest 	:= FALSE;
			eProgramSeqSteps 			:= SEQ_RESET; 		
		END_IF

	
CASE eProgramSeqSteps OF

//	SEQUENCE START
//############################################################################################ 	
	SEQ_IDLE:
		IF bProgramSeqResetComp THEN
			bProgramSeqActive		:= FALSE;
			bProgramSeqResetComp	:= FALSE;
			bProgramSeqReady		:= TRUE;
		END_IF
		
		fbR_TRIG_RunSequence(CLK := bProgramSeqRunRequest);		
//IF ATEQ is BUSY or not connected CycleEnd = 0, if ATEQ is ready CycleEnd = 1
		IF fbR_TRIG_RunSequence.Q AND bDeviceReady THEN
			bResetDeviceDone		:= FALSE;
   			bProgramSeqDone 		:= FALSE;
			bProgramSeqRunRequest	:= FALSE;
			bProgramSeqActive		:= TRUE;
    		eProgramSeqSteps		:= SEQ_RESET_FIFO;
		ELSIF tSeqTimeout.Q THEN
			eProgramSeqSteps		:= SEQ_TIMEOUT;
		END_IF


//############################################################################################ 	
    SEQ_RESET_FIFO: 
	
		eStatesAteqHandshake := mResetFIFO();
					
		IF bFifoResetComplete AND eStatesAteqHandshake = CMD_IDLE THEN
			eProgramSeqSteps := SEQ_AUTO_ZERO; // Opt Consider adding IF Auto Zero Required per Program Recipe here If not Then Go To Program Select
		ELSIF eStatesAteqHandshake = CMD_FAIL THEN
			eProgramSeqSteps := SEQ_ERROR; // Ateq comm failled after retry atempts
		END_IF


//############################################################################################ 
    SEQ_AUTO_ZERO:  
		// Special Cycle ID 16#08 for Piezo Auto Zero Reg 2
		eStatesAteqHandshake := mSpecialCycle(nSpecialCycleId := GVL_AteqSpecialCycle.PiezoAutoZeroReg2); 
    	
		IF bAutoZeroComplete AND eStatesAteqHandshake = CMD_IDLE THEN
			eProgramSeqSteps := SEQ_PROGRAM_SELECT;
		ELSIF eStatesAteqHandshake = CMD_FAIL THEN
			eProgramSeqSteps := SEQ_ERROR; // Ateq comm failed after retry atempts
		END_IF

		
//############################################################################################ 
    SEQ_PROGRAM_SELECT: 
		
		eStatesAteqHandshake := mPrgSelect(); 
		
		IF bProgramSelectComplete AND eStatesAteqHandshake = CMD_IDLE THEN
			eProgramSeqSteps := SEQ_START_PROGRAM;
		ELSIF eStatesAteqHandshake = CMD_FAIL THEN
			eProgramSeqSteps := SEQ_ERROR;
		END_IF	


//############################################################################################ 		
    SEQ_START_PROGRAM:
        
		eStatesAteqHandshake := mPrgStart();
       
		IF bProgramRunComplete AND eStatesAteqHandshake = CMD_IDLE THEN
			eProgramSeqSteps := SEQ_READ_LAST_RESULT;
		ELSIF eStatesAteqHandshake = CMD_FAIL THEN
			eProgramSeqSteps := SEQ_ERROR; // Ateq comm failled after retry atempts
		END_IF

		
//############################################################################################ 				
    SEQ_READ_LAST_RESULT:
        
		eStatesAteqHandshake := mReadLastResult();
		
		IF bReadLastResultComplete AND eStatesAteqHandshake = CMD_IDLE THEN
			eProgramSeqSteps := SEQ_TEST_DONE;
		ELSIF eStatesAteqHandshake = CMD_FAIL THEN
			eProgramSeqSteps := SEQ_ERROR; // Ateq comm failled after retry atempts
		END_IF
		

//############################################################################################         
	(*
	SEQ_READ_FIFO_RESULTS:
		M_ReadFIFO();
	For future: if multiple programs runs in seq then reads the data in chunk
	*)	


//############################################################################################ 	
    SEQ_TEST_DONE:
    	IF bFifoResetComplete
		AND bAutoZeroComplete  
		AND bProgramSelectComplete
		AND bProgramRunComplete
		AND bReadLastResultComplete 
		THEN bProgramSeqDone 	:= TRUE;
		ELSE eProgramSeqSteps := SEQ_ERROR; // Debug Property HMI binding needed
		END_IF


//############################################################################################ 				
    SEQ_ERROR: 
	bProgramSeqError := TRUE;
	//ToHMITags := fbCmdHandler.pCmdErrorReceived; //Debug throw alarms to HMI
	//ToHMITags := fbCmdHandler.pCmdTimeout; //Debug throw alarms to HMI
	
	
//############################################################################################ 	
	SEQ_TIMEOUT: 
	bProgramSeqTimeout := TRUE;
	//ToHMITags


//############################################################################################ 	
	SEQ_RESET:
				
	IF bDeviceReady THEN
		tSeqTimeout(IN := FALSE);
		eStatesAteqHandshake := mReset(); // will return back to IDLE
				
		IF bResetDeviceDone AND eStatesAteqHandshake = CMD_IDLE THEN
			eProgramSeqSteps		:= SEQ_IDLE;
			bProgramSeqResetComp	:= TRUE;		
			bFifoResetComplete		:= FALSE;
			bAutoZeroComplete  		:= FALSE;
			bProgramSelectComplete	:= FALSE;
			bProgramRunComplete		:= FALSE;
			bReadLastResultComplete	:= FALSE;		
		ELSIF eStatesAteqHandshake = CMD_FAIL THEN
			eProgramSeqSteps := SEQ_ERROR; // Ateq comm failled after retry atempts
			// Debug: Need hard fail/HMI Tag etc. or else it will infinite loop	
		END_IF
	ELSIF tSeqTimeout.Q THEN
		eProgramSeqSteps := E_AteqProgramSeqSteps.SEQ_TIMEOUT;
		// Debug: Need hard fail or else it will loop
	END_IF
					
END_CASE]]></ST>
      </Implementation>
    </Method>
    <Method Name="mPrgStart" Id="{df77a28a-31ae-4bb7-aada-fdddd0be9668}">
      <Declaration><![CDATA[METHOD mPrgStart : E_AteqHandshakeSteps
VAR
   
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[
fbCmdHandler.pCmdTrigger := stMappedIoBuf.stWrite.stCommands.bStart;

	fbCmdHandler(
					bCmdEcho    			:= stMappedIoBuf.stRead.stEcho.bStart,
    				bCmdError   			:= stMappedIoBuf.stRead.stErrorCode.bStart,
					stIo_Ref				:= stMappedIoBuf,
					eStatesAteqHandshake	=> mPrgStart
);


	CASE mPrgStart OF
		CMD_IDLE:
			IF NOT bProgramRunComplete THEN
			stMappedIoBuf.stWrite.stCommands.bStart := TRUE; 	
			END_IF
		
		CMD_DONE:
			bProgramRunComplete	:= TRUE;
				   
		CMD_FAIL:
			eErrorFlags := E_AteqControlErrorFlags.ProgramStartFail;
		// Add manual call Faults. Create STRUCT for HMI
	END_CASE;

]]></ST>
      </Implementation>
    </Method>
    <Method Name="mReadFIFO" Id="{2bd2f2bf-d1e5-497c-8c97-5c4c719656ec}">
      <Declaration><![CDATA[METHOD mReadFIFO : E_AteqHandshakeSteps
VAR
     
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[(*
// This command also might simply trigger a data update from FIFO.
// Assuming it does have a command bit and echo/error bits for consistency.
	fbCmdHandler(
					bCmdEcho    	:= stIo.stRead.stEcho.bReadFIFO,
    				bCmdError   	:= stIo.stRead.stErrorCode.bReadFIFO,
					bCmdTrigger 	:= stIo.stWrite.stCommands.bReadFIFO,
					stIo_Ref		:= StIo,
					eStatus			=> M_ReadFIFO
);

//////////////////// DEBUG HERE /////////////////////////
// IF USED Change bindings to eAutoSequenceState in M_ReadLastResult
IF bInAutoMode THEN
		
		CASE M_ReadFIFO OF
			CMD_IDLE:
				IF NOT bReadFIFOComplete THEN
					stIo.stWrite.stCommands.bReadFIFO := TRUE; 
				END_IF
			CMD_DONE:
                bReadFIFOComplete	:= TRUE;
				
        	CMD_FAIL:
            	eStatesAteqProgramAuto := SEQ_ERROR; // Ateq comm failled after retry atempts

        END_CASE;

	IF bReadFIFOComplete AND M_ReadFIFO = CMD_IDLE THEN
		eAutoSequenceState := SEQ_TEST_DONE;
	END_IF
END_IF

*)]]></ST>
      </Implementation>
    </Method>
    <Method Name="mReadLastResult" Id="{bca66d8f-b4be-4355-b92b-b0dac3f24c0c}">
      <Declaration><![CDATA[METHOD mReadLastResult : E_AteqHandshakeSteps
VAR
	
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[
fbCmdHandler.pCmdTrigger := stMappedIoBuf.stWrite.stCommands.bReadLastResult;
	fbCmdHandler(
					bCmdEcho    			:= stMappedIoBuf.stRead.stEcho.bReadLastResult,
    				bCmdError   			:= stMappedIoBuf.stRead.stErrorCode.bReadLastResult,
					stIo_Ref				:= stMappedIoBuf,
					eStatesAteqHandshake	=> mReadLastResult
);


	CASE mReadLastResult OF
		CMD_IDLE:
			IF NOT bReadLastResultComplete THEN
			stMappedIoBuf.stWrite.stCommands.bReadLastResult := TRUE; 
			END_IF
		
		CMD_DONE:
			bReadLastResultComplete	:= TRUE;
				
		CMD_FAIL:
		eErrorFlags := E_AteqControlErrorFlags.ReadLastResultFail;	
		// Add manual call Faults. Create STRUCT for HMI
	END_CASE;

]]></ST>
      </Implementation>
    </Method>
    <Method Name="mReset" Id="{d83d834a-bdff-4813-91dd-64475ca219aa}">
      <Declaration><![CDATA[METHOD mReset : E_AteqHandshakeSteps
VAR
	
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[fbCmdHandler.pResetRequest := TRUE; //Debug throw alarms to HMI

fbCmdHandler.pCmdTrigger := stMappedIoBuf.stWrite.stCommands.bReset;
	fbCmdHandler(
					bCmdEcho        		:= stMappedIoBuf.stRead.stEcho.bReset,
    				bCmdError       		:= stMappedIoBuf.stRead.stErrorCode.bReset, // This is the IN_OUT - FB_CommandHandler will manage it
    				stIo_Ref        		:= stMappedIoBuf,
					eStatesAteqHandshake	=> mReset 
);


		//Verify Reset Conditions when requested
	(*
	IF stMappedIoBuf.stRead.stRealtimeTestResults.bPass 
	OR stMappedIoBuf.stRead.stRealtimeTestResults.bFailPart
	OR stMappedIoBuf.stRead.stRealtimeTestResults.bFailRef
	OR stMappedIoBuf.stRead.stRealtimeTestResults.bAlarm 
	OR stMappedIoBuf.stRead.anErrorCode[0] <> 0 
	OR stMappedIoBuf.stRead.anErrorCode[1] <> 0 THEN
	bResetRequired := TRUE;
	END_IF
	*)
	CASE mReset OF
			
		CMD_IDLE:
			IF fbCmdHandler.pReady AND NOT bResetDeviceDone THEN
			stMappedIoBuf.stWrite.stCommands.bReset := TRUE;
			END_IF
				
		CMD_DONE:	
			bResetDeviceDone := TRUE;
				
		CMD_FAIL:
			eErrorFlags := E_AteqControlErrorFlags.ResetDeviceFail;
			
	END_CASE
		
]]></ST>
      </Implementation>
    </Method>
    <Method Name="mResetFIFO" Id="{d2dd068a-bc41-4e1b-8fe3-37e11fad9b4b}">
      <Declaration><![CDATA[METHOD mResetFIFO : E_AteqHandshakeSteps
VAR
  		
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[
fbCmdHandler.pCmdTrigger := stMappedIoBuf.stWrite.stCommands.bResetFIFO;
	fbCmdHandler(
					bCmdEcho        		:= stMappedIoBuf.stRead.stEcho.bResetFIFO,
    				bCmdError       		:= stMappedIoBuf.stRead.stErrorCode.bResetFIFO,
					stIo_Ref        		:= stMappedIoBuf,
					eStatesAteqHandshake	=> mResetFIFO 
);

	
	
	CASE mResetFIFO OF
		CMD_IDLE:
			IF NOT bFifoResetComplete THEN	
			stMappedIoBuf.stWrite.stCommands.bResetFIFO  := TRUE;
			END_IF
		
		CMD_DONE:
		IF stMappedIoBuf.stRead.nResultsInFifo = 0 THEN
			bFifoResetComplete	:= TRUE;
		END_IF
				
		CMD_FAIL:
			eErrorFlags := E_AteqControlErrorFlags.ResetFIFOFail;
	END_CASE


]]></ST>
      </Implementation>
    </Method>
    <Method Name="mSpecialCycle" Id="{d187d757-2cbf-4176-839b-3ef7d7928184}">
      <Declaration><![CDATA[METHOD mSpecialCycle : E_AteqHandshakeSteps
VAR_INPUT
    nSpecialCycleId	: WORD; // Input for the special cycle ID (GVL_AteqSpecialCycle.PiezoAutoZeroReg2 for AutoZero 16#08)
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[
stMappedIoBuf.stWrite.nSpecialCycle := nSpecialCycleId; // Sets the special cycle ID register
fbCmdHandler.pCmdTrigger := stMappedIoBuf.stWrite.stCommands.bSpecialCycle;
	fbCmdHandler(
   					bCmdEcho    			:= stMappedIoBuf.stRead.stEcho.bSpecialCycle,
    				bCmdError   			:= stMappedIoBuf.stRead.stErrorCode.bSpecialCycle,
					stIo_Ref				:= stMappedIoBuf,
					eStatesAteqHandshake	=> mSpecialCycle
);

	
	CASE mSpecialCycle OF
		CMD_IDLE:
			IF NOT bAutoZeroComplete THEN
			stMappedIoBuf.stWrite.stCommands.bSpecialCycle 	:= TRUE;
			stMappedIoBuf.stWrite.stCommands.bStart 			:= TRUE; 
			// Only Special Cycle cmd needs Start bit TRUE to run
			END_IF
				
		CMD_DONE:
			stMappedIoBuf.stWrite.nSpecialCycle := 0; // Clear; prevent re-triggering
			stMappedIoBuf.stWrite.stCommands.bStart 	:= FALSE;
			bAutoZeroComplete	:= TRUE;

		CMD_FAIL:
			stMappedIoBuf.stWrite.nSpecialCycle := 0; // Clear; prevent re-triggering
			eErrorFlags := E_AteqControlErrorFlags.SpecialCycleFail;
	END_CASE;
	



]]></ST>
      </Implementation>
    </Method>
