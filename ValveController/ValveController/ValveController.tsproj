							<Name>GVL_MapIoDevice2.Frm0State</Name>
							<Type>UINT</Type>
						</Var>
						<Var>
							<Name>GVL_MapIoDevice2.Frm0WcState</Name>
							<Comment><![CDATA[			
0x0001 = 1. EtherCAT command NOT sent (NOP requested)							
0x0002 = 2. EtherCAT command not sent (NOP requested)																				
0x0004 = 3. EtherCAT command not sent (NOP requested)																				
...																				
0x4000 = 15. EtherCAT command not sent (NOP requested)																				
0x8000 = complete frame not sent										
]]></Comment>
							<Type>UINT</Type>
						</Var>
						<Var>
							<Name>GVL_MapIoDevice2.Frm0InputToggle</Name>
							<Comment><![CDATA[			
0x0001 = wrong working counter of 1. EtherCAT command received								
0x0002 = wrong working counter of 2. EtherCAT command received																	
0x0004 = wrong working counter of 3. EtherCAT command received																				
...																				
0x4000 = wrong working counter of 15. EtherCAT command received																				
0x8000 = complete frame missing										
]]></Comment>
							<Type>UINT</Type>
						</Var>
						<Var>
							<Name>GVL_MapIoDevice2.SlaveCount</Name>
							<Comment><![CDATA[ Actual count OF EtherCAT slaves received	]]></Comment>
							<Type>UINT</Type>
						</Var>
						<Var>
							<Name>GVL_MapIoDevice2.DevState</Name>
							<Type>UINT</Type>
						</Var>
						<Var>
							<Name>GVL_MapIoDevice2.ChangeCount</Name>
							<Comment><![CDATA[InfoData]]></Comment>
							<Type>UINT</Type>
						</Var>
						<Var>
							<Name>GVL_MapIoDevice2.DevId</Name>
							<Type>UINT</Type>
						</Var>
						<Var>
							<Name>GVL_MapIoDevice2.AmsNetId</Name>
							<Type GUID="{18071995-0000-0000-0000-000000000041}">AMSNETID</Type>
						</Var>
