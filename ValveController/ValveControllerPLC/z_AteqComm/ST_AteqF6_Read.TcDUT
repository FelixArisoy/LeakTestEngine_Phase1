  <DUT Name="ST_AteqF6_Read" Id="{4bdec2e8-abb3-425c-a531-ebad90f3fcff}">
    <Declaration><![CDATA[TYPE ST_AteqF6_Read :
STRUCT
	aEchoCmd 			: ARRAY[0..1] OF BYTE;     // 00h–01h
    aEchoErrors 		: ARRAY[0..1] OF BYTE;     // 02h–03h
    aReserved1 			: ARRAY[0..1] OF BYTE;     // 04h–05h
    nProgramInUse 		: WORD;                    // 06h–07h
    nResultsInFifo   	: WORD;                    // 08h–09h
    nTestType 			: WORD;                    // 0Ah–0Bh
    nRealTimeResults	: WORD;                    // 0Ch–0Dh
    nProgramStep  		: WORD;                    // 0Eh–0Fh
    aDataPayload		: ARRAY[0..47] OF BYTE;    // 10h–3Fh
END_STRUCT
END_TYPE
]]></Declaration>
  </DUT>
