<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.15">
  <GVL Name="GVL_Ateq" Id="{8341f924-21b8-4660-ac80-fb81e367c10a}">
    <Declaration><![CDATA[// shared IO variables for one ATEQ device
VAR_GLOBAL CONSTANT
    nAteqF6_DevCount : UINT := 12; // Set; based on Total Num of F6 ATEQ devices
END_VAR

VAR_GLOBAL
   // Each device has 64 bytes of input/output memory
    anInputRaw  AT %I* : ARRAY[0..nAteqF6_DevCount - 1] OF ARRAY[0..3] OF ARRAY[0..63] OF BYTE;
	anOutputRaw AT %Q* : ARRAY[0..nAteqF6_DevCount - 1] OF ARRAY[0..3] OF ARRAY[0..63] OF BYTE;


    astDeviceIo    	: ARRAY[0..nAteqF6_DevCount - 1] OF ST_AteqIo;        // Device structures
    abHeartbeat 	: ARRAY[0..nAteqF6_DevCount - 1] OF BOOL;             // Heartbeat status per device
END_VAR
]]></Declaration>
  </GVL>
</TcPlcObject>