    nProgramNumber	: WORD;
    nValveMask		: DWORD;

END_VAR

VAR
	bProgramSeqRunCmdToAteq		: BOOL;	
	bProgramSeqResetCmdToAteq	: BOOL;
	tRecipeHandlerTimeout 		: TON;
	nIndexToCurrentProgram		: INT;
    tValveStable : TON;


END_VAR
