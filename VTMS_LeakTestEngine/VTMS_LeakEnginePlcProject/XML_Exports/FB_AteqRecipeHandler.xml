    <pous>
      <pou name="FB_AteqRecipeHandler" pouType="functionBlock">
        <interface>
          <inputVars>
            <variable name="bValveBankHasAnyError">
              <type>
                <BOOL />
              </type>
            </variable>
            <variable name="bLastResultsStored">
              <type>
                <BOOL />
              </type>
            </variable>
            <variable name="anProgramNumberRecipe">
              <type>
                <array>
                  <dimension lower="0" upper="(GVL_AteqConfig.nMaxProgramsToRun - 1)" />
                  <baseType>
                    <WORD />
                  </baseType>
                </array>
              </type>
            </variable>
            <variable name="anValveMask">
              <type>
                <array>
                  <dimension lower="0" upper="(GVL_AteqConfig.nMaxProgramsToRun - 1)" />
                  <baseType>
                    <DWORD />
                  </baseType>
                </array>
              </type>
            </variable>
            <variable name="eAteqProgramSeqStates">
              <type>
                <derived name="E_AteqProgramSeqSteps" />
              </type>
            </variable>
            <variable name="eProgramInternalSteps">
              <type>
                <derived name="E_AteqStepsTable" />
              </type>
            </variable>
          </inputVars>
          <inOutVars>
            <variable name="bAutoTestRecipeStart">
              <type>
                <BOOL />
              </type>
              <documentation>
                <xhtml xmlns="http://www.w3.org/1999/xhtml"> Flag will be binded to Main PLC Run Cmd</xhtml>
              </documentation>
            </variable>
          </inOutVars>
          <outputVars>
            <variable name="eStatesAteqRecipeHandler">
              <type>
                <derived name="E_AteqRecipeHandlerSteps" />
              </type>
            </variable>
            <variable name="nProgramNumber">
              <type>
                <WORD />
              </type>
            </variable>
            <variable name="nValveMask">
              <type>
                <DWORD />
              </type>
            </variable>
          </outputVars>
          <localVars>
            <variable name="bProgramSeqRunCmdToAteq">
              <type>
                <BOOL />
              </type>
            </variable>
            <variable name="bProgramSeqResetCmdToAteq">
              <type>
                <BOOL />
              </type>
            </variable>
            <variable name="tRecipeHandlerTimeout">
              <type>
                <derived name="TON" />
              </type>
            </variable>
            <variable name="nIndexToCurrentProgram">
              <type>
                <INT />
              </type>
            </variable>
            <variable name="tValveStable">
              <type>
                <derived name="TON" />
              </type>
            </variable>
          </localVars>
        </interface>
        <body>
          <ST>
            <xhtml xmlns="http://www.w3.org/1999/xhtml">tRecipeHandlerTimeout(In := TRUE, PT := T#15S);  // Debug move it to GVL 
	CASE eStatesAteqRecipeHandler OF

        E_AteqRecipeHandlerSteps.RECIPE_IDLE: // Idle 
			
			IF bAutoTestRecipeStart AND eAteqProgramSeqStates = SEQ_IDLE THEN
				tValveStable.PT := GVL_ValveBankConfig.tValveStabilizationTime;
				nIndexToCurrentProgram := 0;
				bProgramSeqResetCmdToAteq := TRUE;
				bAutoTestRecipeStart := FALSE;
				eStatesAteqRecipeHandler := E_AteqRecipeHandlerSteps.RECIPE_TRIGGER_VALVES;
			END_IF
			
			
        E_AteqRecipeHandlerSteps.RECIPE_TRIGGER_VALVES: // Valve Cmd On From Mask
            IF NOT bValveBankHasAnyError THEN
				tRecipeHandlerTimeout(IN := FALSE);
				bProgramSeqResetCmdToAteq := FALSE;
				nValveMask := anValveMask[nIndexToCurrentProgram];            
            	eStatesAteqRecipeHandler := 2;
			ELSIF tRecipeHandlerTimeout.Q THEN
					eStatesAteqRecipeHandler := 4;
			END_IF
			

        E_AteqRecipeHandlerSteps.RECIPE_WAIT_VALVES: //  Wait for valve stabilization
            tValveStable(IN := TRUE);
			
            IF tValveStable.Q  THEN
                tValveStable(IN := FALSE);
				eStatesAteqRecipeHandler := E_AteqRecipeHandlerSteps.RECIPE_RUN_ATEQ;
			ELSIF tRecipeHandlerTimeout.Q THEN
					eStatesAteqRecipeHandler := E_AteqRecipeHandlerSteps.RECIPE_TIMEOUT;
            END_IF
		
			
		E_AteqRecipeHandlerSteps.RECIPE_RUN_ATEQ:
    		nProgramNumber := anProgramNumberRecipe[nIndexToCurrentProgram];
    		bProgramSeqRunCmdToAteq := TRUE;

   			 // Dump Step Detected
    		IF eProgramInternalSteps = E_AteqStepsTable.Dump THEN //Debug may not need it bcs Pr Auto zeros every time which adds upp quite some time for Valves to kick in
        		eStatesAteqRecipeHandler := E_AteqRecipeHandlerSteps.RECIPE_RESULT_STORED;
    		ELSIF eAteqProgramSeqStates = SEQ_ERROR OR eAteqProgramSeqStates = SEQ_TIMEOUT THEN
        		eStatesAteqRecipeHandler := E_AteqRecipeHandlerSteps.RECIPE_TIMEOUT;
    		END_IF

			         	
		E_AteqRecipeHandlerSteps.RECIPE_RESULT_STORED: //Recipe Handler Error
			IF bLastResultsStored THEN
				bProgramSeqResetCmdToAteq := TRUE; // Reset ATEQ
				 IF nIndexToCurrentProgram &gt;= GVL_AteqConfig.nMaxProgramsToRun - 1 THEN
                	eStatesAteqRecipeHandler := E_AteqRecipeHandlerSteps.RECIPE_IDLE;
            	ELSE
                	nIndexToCurrentProgram := nIndexToCurrentProgram + 1;
                	eStatesAteqRecipeHandler := E_AteqRecipeHandlerSteps.RECIPE_TRIGGER_VALVES;
            	END_IF
			END_IF
		
			E_AteqRecipeHandlerSteps.RECIPE_ERROR:
			;
			E_AteqRecipeHandlerSteps.RECIPE_TIMEOUT:
			;
    END_CASE

</xhtml>
          </ST>
        </body>
