                    </type>
                  </variable>
                </localVars>
              </interface>
              <body>
                <ST>
                  <xhtml xmlns="http://www.w3.org/1999/xhtml">// mapp the hardware specific valve bank Status bits here if available</xhtml>
                </ST>
              </body>
