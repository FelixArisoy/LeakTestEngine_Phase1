              <interface>
                <returnType>
                  <BOOL />
                </returnType>
              </interface>
              <body>
                <ST>
                  <xhtml xmlns="http://www.w3.org/1999/xhtml">IF stFieldDevice.bDeviceEnableCmd AND stFieldDevice.bDeviceCommOK THEN
	stFieldDevice.bDeviceEnabled := TRUE;
	M_DeviceEnable := TRUE;
	ELSE
		stFieldDevice.bDeviceFaulted := TRUE;
		M_DeviceEnable := FALSE;
	END_IF
	
</xhtml>
                </ST>
              </body>
