          <data name="http://www.3s-software.com/plcopenxml/method" handleUnknown="implementation">
            <Method name="M_TriggerFromMask" ObjectId="fe376a1d-db65-4f96-89c4-385f8cf1d130">
              <interface>
                <returnType>
                  <BOOL />
                </returnType>
                <localVars>
                  <variable name="i">
                    <type>
                      <INT />
                    </type>
                  </variable>
                  <variable name="bitSet">
                    <type>
                      <BOOL />
                    </type>
                  </variable>
                </localVars>
              </interface>
              <body>
                <ST>
                  <xhtml xmlns="http://www.w3.org/1999/xhtml">FOR i := 0 TO nNumOfValvesAvailable - 1 DO
    
	IF i &gt;= 0 AND i &lt; 32 THEN // Prevent accidental bit shifting
		bitSet := (nValveMask AND SHL(1, i)) &lt;&gt; 0;
	END_IF
	
 
    IF NOT afbValve[i].pDeviceFaulted  THEN
        IF bitSet THEN
			aipValve[i]^.M_ActOpen();
        ELSE
            aipValve[i]^.M_ActClose();
        END_IF
    END_IF
END_FOR

M_TriggerFromMask := TRUE;
</xhtml>
                </ST>
              </body>
              <InterfaceAsPlainText>
                <xhtml xmlns="http://www.w3.org/1999/xhtml">METHOD M_TriggerFromMask : BOOL
VAR
    i : INT;
    bitSet : BOOL;
END_VAR</xhtml>
              </InterfaceAsPlainText>
              <addData />
            </Method>
          </data>
          <data name="http://www.3s-software.com/plcopenxml/method" handleUnknown="implementation">
            <Method name="M_TriggerManual" ObjectId="8af14a3c-2dc8-4674-a94b-adeb0c9e665c">
              <interface>
                <returnType>
                  <BOOL />
                </returnType>
                <localVars>
                  <variable name="i">
                    <type>
                      <INT />
                    </type>
                  </variable>
                </localVars>
              </interface>
              <body>
                <ST>
                  <xhtml xmlns="http://www.w3.org/1999/xhtml">
FOR i := 0 TO nNumOfValvesAvailable - 1 DO
    
	IF NOT afbValve[i].pDeviceFaulted THEN
        
		IF anReqOpenManual[i] THEN
			aipValve[i]^.M_ActOpen(); 
		
		ELSIF anReqCloseManual[i] THEN	
			aipValve[i]^.M_ActClose(); 
		END_IF
		
    END_IF
END_FOR
</xhtml>
                </ST>
              </body>
              <InterfaceAsPlainText>
                <xhtml xmlns="http://www.w3.org/1999/xhtml">METHOD M_TriggerManual : BOOL
VAR
    i : INT;
END_VAR</xhtml>
              </InterfaceAsPlainText>
              <addData />
            </Method>
          </data>
