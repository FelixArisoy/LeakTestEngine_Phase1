          <data name="http://www.3s-software.com/plcopenxml/method" handleUnknown="implementation">
            <Method name="M_InitValves" ObjectId="ac7296a0-4fd1-48dd-acf9-7aefb8e3ff93">
              <interface>
                <localVars>
                  <variable name="i">
                    <type>
                      <INT />
                    </type>
                  </variable>
                </localVars>
              </interface>
              <body>
                <ST>
                  <xhtml xmlns="http://www.w3.org/1999/xhtml">
FOR i := 0 TO nNumOfValvesAvailable - 1 DO
	//afbValve[i]();
	aipValve[i]^.pDeviceCommOK := TRUE; // Map Individual valve HB from VB if available
	aipValve[i]^.pDeviceEnableCmd := TRUE; // Enable all
	
	abValveHeartbeat[i] := aipValve[i]^.M_DeviceHeartbeat(); // init all valves that are connected to the bank
	aeValveStatus[i] 	:= aipValve[i]^.M_DeviceStatus(); // Array will be mapped to HMI	
END_FOR


//OR mapp the VB Status  bits here</xhtml>
                </ST>
              </body>
              <InterfaceAsPlainText>
                <xhtml xmlns="http://www.w3.org/1999/xhtml">METHOD M_InitValves
VAR
    i : INT;
END_VAR</xhtml>
              </InterfaceAsPlainText>
              <addData />
            </Method>
