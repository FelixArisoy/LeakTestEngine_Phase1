          <data name="http://www.3s-software.com/plcopenxml/method" handleUnknown="implementation">
            <Method name="M_Status" ObjectId="f41bb54e-9b59-49d0-856c-e790c3a7a76a">
              <interface>
                <returnType>
                  <derived name="E_ValveStatus" />
                </returnType>
              </interface>
              <body>
                <ST>
                  <xhtml xmlns="http://www.w3.org/1999/xhtml">
// nValveFeedback binded through the properties. 
// Adjust GVL values depending on valvebank hardware config
bShortCircuit   := (nValveFeedback AND GVL_ValveStatus.SHORT_CIRCUIT) &lt;&gt; 0;
bOpenCircuit   	:= (nValveFeedback AND GVL_ValveStatus.OPEN_CIRCUIT) &lt;&gt; 0;
bManualOverride := (nValveFeedback AND GVL_ValveStatus.STATUS_FAULT_OVERRIDE) &lt;&gt; 0;

bSolenoidFaulted := bShortCircuit OR bOpenCircuit;

// Return status enum
IF bShortCircuit THEN
    M_Status := E_ValveStatus.SHORT_CIRCUIT;
	bFaulted := TRUE;
ELSIF bOpenCircuit THEN
    M_Status := E_ValveStatus.OPEN_CIRCUIT;
	bFaulted := TRUE;
ELSIF bManualOverride THEN
    M_Status := E_ValveStatus.MANUAL_OVERRIDE; // Manual is active while Valve requested
	bFaulted := TRUE;
//ELSIF NOT (bOpened OR bClosed) THEN
//   M_Status := E_ValveStatus.UNKNOWN_FAULT; // Verify Valve Position
ELSE
    M_Status := E_ValveStatus.OK; // Comm or heartbeat bits maybe binded 
END_IF
</xhtml>
                </ST>
              </body>
              <InterfaceAsPlainText>
                <xhtml xmlns="http://www.w3.org/1999/xhtml">METHOD M_Status : E_ValveStatus
</xhtml>
              </InterfaceAsPlainText>
              <addData />
            </Method>
          </data>
