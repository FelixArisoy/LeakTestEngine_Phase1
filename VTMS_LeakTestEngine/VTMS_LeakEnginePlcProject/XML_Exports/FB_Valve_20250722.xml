          <data name="http://www.3s-software.com/plcopenxml/method" handleUnknown="implementation">
            <Method name="M_Close" ObjectId="1d16d4c9-6a39-44b9-8565-d407aaf3c08c">
              <interface>
                <returnType>
                  <BOOL />
                </returnType>
                <localVars>
                  <variable name="tValveTimeout">
                    <type>
                      <derived name="TON" />
                    </type>
                  </variable>
                </localVars>
              </interface>
              <body>
                <ST>
                  <xhtml xmlns="http://www.w3.org/1999/xhtml">	// There is no safe to operate check as this valve will be supervised by the Main PLC.
	//	Main PLC is responsible with safety monitoring and motion activity.
IF GVL_AteqConfig.bValvePosFeedbackUsed THEN
	
	IF NOT bClosed AND NOT bFaulted THEN
		bCmdClose := TRUE;
		tValveTimeout(IN := TRUE, PT := T#1000MS);
	END_IF

	IF bClosed THEN
		tValveTimeout(IN := FALSE);		
		bCmdClose 	:= FALSE;		
		M_Close 	:= TRUE;
	
	ELSIF tValveTimeout.Q THEN
		tValveTimeout(IN := FALSE);	
		bFaulted := TRUE;
	END_IF

ELSE	//Runs valves witout position feeedback
		bCmdClose 	:= TRUE;
 		bCmdOpen 	:= FALSE;
 		M_Close 	:= TRUE;	
END_IF</xhtml>
                </ST>
              </body>
              <InterfaceAsPlainText>
                <xhtml xmlns="http://www.w3.org/1999/xhtml">METHOD M_Close : BOOL // Return this if no pos feedback used
VAR
	tValveTimeout : TON;
END_VAR</xhtml>
              </InterfaceAsPlainText>
              <addData />
            </Method>
          </data>
          <data name="http://www.3s-software.com/plcopenxml/method" handleUnknown="implementation">
            <Method name="M_Open" ObjectId="a47b2e7e-6fcc-450a-be9b-01c5b6f5eb05">
              <interface>
                <returnType>
                  <BOOL />
                </returnType>
                <localVars>
                  <variable name="tValveTimeout">
                    <type>
                      <derived name="TON" />
                    </type>
                  </variable>
                </localVars>
              </interface>
              <body>
                <ST>
                  <xhtml xmlns="http://www.w3.org/1999/xhtml">	// There is no safe to operate check as this valve will be supervised by the Main PLC.
	//	Main PLC is responsible with safety monitoring and motion activity.
IF GVL_AteqConfig.bValvePosFeedbackUsed THEN
	
	IF NOT bOpened AND NOT bFaulted THEN
		bCmdOpen := TRUE;
		tValveTimeout(IN := TRUE, PT := T#1000MS);
	END_IF

	IF bOpened THEN
		tValveTimeout(IN := FALSE);		
		bCmdOpen 	:= FALSE;		
		M_Open 		:= TRUE;
	
	ELSIF tValveTimeout.Q THEN
		tValveTimeout(IN := FALSE);	
		bFaulted := TRUE;
	END_IF

ELSE	//Runs valves witout position feeedback
		bCmdOpen 	:= TRUE;
 		bCmdClose 	:= FALSE;
 		M_Open 		:= TRUE;
END_IF	</xhtml>
                </ST>
              </body>
              <InterfaceAsPlainText>
                <xhtml xmlns="http://www.w3.org/1999/xhtml">METHOD M_Open : BOOL //Opens the Valve
VAR
	tValveTimeout : TON;
END_VAR</xhtml>
              </InterfaceAsPlainText>
              <addData />
            </Method>
