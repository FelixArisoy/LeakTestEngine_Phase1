        <body>
          <ST>
            <xhtml xmlns="http://www.w3.org/1999/xhtml">// Step readiness check 
bStepReady := TRUE;
FOR i := 0 TO GVL_AteqConfig.nMaxDeviceCount - 1 DO
    IF (aValveMaskSteps[nCurrentSeqStepIndex].nExpectedDoneMask AND SHL(1, i)) &lt;&gt; 0 THEN
        IF NOT abValveMaskSetRequest[i] THEN
            bStepReady := FALSE;
            EXIT;
        END_IF
    END_IF
END_FOR

CASE eState OF
    IDLE:
        IF bStepReady THEN
            aPreviousMask := aCurrentValveMask;
            CASE aValveMaskSteps[nCurrentSeqStepIndex].eTransitionMode OF

                HoldPrevious_ON: // OBC Open Next before Closing Previous
                    aIntermediateMask := M_ComposeValveMask(aAteqValveMaps, aAteqValveMasks);
                    FOR i := 0 TO 3 DO
                        aCurrentValveMask[i] := aPreviousMask[i] OR aIntermediateMask[i];
                    END_FOR
                    eState := TRANSITION_HOLD;
                   
                HoldNext_OFF: // CBO Close Previous before Openning Next
                    aIntermediateMask := M_ComposeValveMask(aAteqValveMaps, aAteqValveMasks);
                    FOR i := 0 TO 3 DO
                        aCurrentValveMask[i] := aPreviousMask[i] AND NOT aIntermediateMask[i];
                    END_FOR
                    eState := TRANSITION_HOLD;
                    
                Immediate:
                    aCurrentValveMask := M_ComposeValveMask(aAteqValveMaps, aAteqValveMasks);
                    bValveMaskSetDone := TRUE;
                    nCurrentSeqStepIndex := nCurrentSeqStepIndex + 1;
            END_CASE
        END_IF

    TRANSITION_HOLD:
       tTransitionHold(IN := TRUE, PT := aValveMaskSteps[nCurrentSeqStepIndex].tTransitionHoldTime);

        IF tTransitionHold.Q THEN
            eState := APPLY_FINAL;
            tTransitionHold(IN := FALSE);
        END_IF

    APPLY_FINAL:
        aCurrentValveMask := M_ComposeValveMask(aAteqValveMaps, aAteqValveMasks);
        bValveMaskSetDone := TRUE;
        nCurrentSeqStepIndex := nCurrentSeqStepIndex + 1;
        eState := IDLE;
END_CASE
</xhtml>
          </ST>
        </body>
        <addData>
          <data name="http://www.3s-software.com/plcopenxml/method" handleUnknown="implementation">
            <Method name="M_ComposeValveMask" ObjectId="02ff877c-ba6f-43fd-98c2-2957bc2319d2">
              <interface>
                <returnType>
                  <array>
                    <dimension lower="0" upper="3" />
                    <baseType>
                      <DWORD />
                    </baseType>
                  </array>
                </returnType>
                <inputVars>
                  <variable name="aValveMaps">
                    <type>
                      <array>
                        <dimension lower="0" upper="(GVL_AteqConfig.nMaxDeviceCount - 1)" />
                        <baseType>
                          <derived name="ST_AteqValveMap" />
                        </baseType>
                      </array>
                    </type>
                  </variable>
                  <variable name="aMasks">
                    <type>
                      <array>
                        <dimension lower="0" upper="(GVL_AteqConfig.nMaxDeviceCount - 1)" />
                        <baseType>
                          <array>
                            <dimension lower="0" upper="3" />
                            <baseType>
                              <DWORD />
                            </baseType>
                          </array>
                        </baseType>
                      </array>
                    </type>
                  </variable>
                </inputVars>
                <localVars>
                  <variable name="result">
                    <type>
                      <array>
                        <dimension lower="0" upper="3" />
                        <baseType>
                          <DWORD />
                        </baseType>
                      </array>
                    </type>
                    <initialValue>
                      <arrayValue>
                        <value>
                          <simpleValue value="0" />
                        </value>
                        <value>
                          <simpleValue value="0" />
                        </value>
                        <value>
                          <simpleValue value="0" />
                        </value>
                        <value>
                          <simpleValue value="0" />
                        </value>
                      </arrayValue>
                    </initialValue>
                  </variable>
                  <variable name="idx">
                    <type>
                      <UINT />
                    </type>
                  </variable>
                  <variable name="bitOffset">
                    <type>
                      <UINT />
                    </type>
                  </variable>
                  <variable name="wordIndex">
                    <type>
                      <UINT />
                    </type>
                  </variable>
                  <variable name="shiftedMask">
                    <type>
                      <array>
                        <dimension lower="0" upper="3" />
                        <baseType>
                          <DWORD />
                        </baseType>
                      </array>
                    </type>
                  </variable>
                </localVars>
                <addData>
                  <data name="http://www.3s-software.com/plcopenxml/accessmodifiers" handleUnknown="implementation">
                    <AccessModifiers Private="true" />
                  </data>
                </addData>
              </interface>
              <body>
                <ST>
                  <xhtml xmlns="http://www.w3.org/1999/xhtml">
FOR idx := 0 TO GVL_AteqConfig.nMaxDeviceCount - 1 DO
    FOR wordIndex := 0 TO 3 DO
        bitOffset := aValveMaps[idx].nValveStartIndex;
        IF bitOffset &lt; 32 THEN
            result[0] := result[0] OR SHL(aMasks[idx][wordIndex], bitOffset);
        ELSIF bitOffset &lt; 64 THEN
            result[1] := result[1] OR SHL(aMasks[idx][wordIndex], bitOffset - 32);
        ELSIF bitOffset &lt; 96 THEN
            result[2] := result[2] OR SHL(aMasks[idx][wordIndex], bitOffset - 64);
        ELSE
            result[3] := result[3] OR SHL(aMasks[idx][wordIndex], bitOffset - 96);
        END_IF
    END_FOR
END_FOR
M_ComposeValveMask := result;</xhtml>
                </ST>
              </body>
