        <addData>
          <data name="http://www.3s-software.com/plcopenxml/method" handleUnknown="implementation">
            <Method name="M_ActClose" ObjectId="1d16d4c9-6a39-44b9-8565-d407aaf3c08c">
              <interface>
                <returnType>
                  <BOOL />
                </returnType>
                <localVars>
                  <variable name="tValveTimeout">
                    <type>
                      <derived name="TON" />
                    </type>
                  </variable>
                </localVars>
              </interface>
              <body>
                <ST>
                  <xhtml xmlns="http://www.w3.org/1999/xhtml">	// There is no safe to operate check as this valve will be supervised by the Main PLC.
	//	Main PLC is responsible with safety monitoring and motion activity.
IF GVL_ValveBankConfig.bValvePosSensorUsed THEN
	
	IF NOT bClosedPosSensor AND NOT stFieldDevice.bDeviceFaulted THEN
		bOpenCmd 	:= FALSE;
		bCloseCmd 	:= TRUE;
		tValveTimeout(IN := TRUE, PT := GVL_ValveBankConfig.bValveActTimeout);
	END_IF

	IF bClosedPosSensor THEN
		tValveTimeout(IN := FALSE);		
		bCloseCmd 	:= FALSE;
		bClosed 	:= TRUE;
		bOpened		:= TRUE;		
	
	ELSIF tValveTimeout.Q THEN
		tValveTimeout(IN := FALSE);	
		stFieldDevice.bDeviceFaulted := TRUE;
	END_IF

ELSE	//Runs valves witout position feeedback
		bCloseCmd 	:= TRUE;
 		bOpenCmd 	:= FALSE;
 		bClosed 	:= TRUE;
		bOpened 	:= FALSE;	
END_IF</xhtml>
                </ST>
              </body>
              <InterfaceAsPlainText>
                <xhtml xmlns="http://www.w3.org/1999/xhtml">METHOD M_ActClose : BOOL
VAR
	tValveTimeout : TON;
END_VAR</xhtml>
              </InterfaceAsPlainText>
              <addData />
            </Method>
          </data>
          <data name="http://www.3s-software.com/plcopenxml/method" handleUnknown="implementation">
            <Method name="M_ActOpen" ObjectId="a47b2e7e-6fcc-450a-be9b-01c5b6f5eb05">
              <interface>
                <returnType>
                  <BOOL />
                </returnType>
                <localVars>
                  <variable name="tValveTimeout">
                    <type>
                      <derived name="TON" />
                    </type>
                  </variable>
                </localVars>
              </interface>
              <body>
                <ST>
                  <xhtml xmlns="http://www.w3.org/1999/xhtml">	// There is no safe to operate check as this valve will be supervised by the Main PLC.
	//	Main PLC is responsible with safety monitoring and motion activity.
IF GVL_ValveBankConfig.bValvePosSensorUsed THEN
	
	IF NOT bOpenedPosSensor AND NOT stFieldDevice.bDeviceFaulted THEN
		bCloseCmd 	:= FALSE;
		bOpenCmd 	:= TRUE;
		tValveTimeout(IN := TRUE, PT := GVL_ValveBankConfig.bValveActTimeout);
	END_IF

	IF bOpenedPosSensor THEN
		tValveTimeout(IN := FALSE);		
		bOpenCmd 	:= FALSE;
		bOpened 	:= TRUE;
		bClosed		:= FALSE;		
	
	ELSIF tValveTimeout.Q THEN
		tValveTimeout(IN := FALSE);	
		stFieldDevice.bDeviceFaulted := TRUE;
	END_IF

ELSE	//Runs valves witout position feeedback
		bOpenCmd 	:= TRUE;
 		bCloseCmd 	:= FALSE;
		bOpened 	:= TRUE;	
		bClosed		:= FALSE;

END_IF	</xhtml>
                </ST>
              </body>
              <InterfaceAsPlainText>
                <xhtml xmlns="http://www.w3.org/1999/xhtml">METHOD M_ActOpen : BOOL //Opens the Valve
VAR
	tValveTimeout : TON;
END_VAR</xhtml>
              </InterfaceAsPlainText>
              <addData />
            </Method>
