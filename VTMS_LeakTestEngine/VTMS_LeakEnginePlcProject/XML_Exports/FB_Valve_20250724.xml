          <data name="http://www.3s-software.com/plcopenxml/method" handleUnknown="implementation">
            <Method name="M_DeviceStatus" ObjectId="f41bb54e-9b59-49d0-856c-e790c3a7a76a">
              <interface>
                <returnType>
                  <derived name="E_StatusFieldDevice" />
                </returnType>
                <localVars>
                  <variable name="nStatusFeedback">
                    <type>
                      <DWORD />
                    </type>
                    <documentation>
                      <xhtml xmlns="http://www.w3.org/1999/xhtml"> Size depends on the hardware config</xhtml>
                    </documentation>
                  </variable>
                </localVars>
              </interface>
              <body>
                <ST>
                  <xhtml xmlns="http://www.w3.org/1999/xhtml">// nValveFeedback binded through the properties. 
// Adjust GVL values depending on valvebank hardware config
bShortCircuit   := (nStatusFeedback AND GVL_ValveStatus.SHORT_CIRCUIT) &lt;&gt; 0;
bOpenCircuit   	:= (nStatusFeedback AND GVL_ValveStatus.OPEN_CIRCUIT) &lt;&gt; 0;
bManualOverride := (nStatusFeedback AND GVL_ValveStatus.STATUS_FAULT_OVERRIDE) &lt;&gt; 0;

bSolenoidFaulted := bShortCircuit OR bOpenCircuit;

// Return status enum
IF bShortCircuit THEN
    M_DeviceStatus := E_StatusFieldDevice.SHORT_CIRCUIT;
	stFieldDevice.bDeviceFaulted := TRUE;
ELSIF bOpenCircuit THEN
    M_DeviceStatus := E_StatusFieldDevice.OPEN_CIRCUIT;
	stFieldDevice.bDeviceFaulted := TRUE;
ELSIF bManualOverride THEN
    M_DeviceStatus := E_StatusFieldDevice.MANUAL_OVERRIDE; // Manual is active while Valve requested
	stFieldDevice.bDeviceFaulted := TRUE;
ELSIF GVL_ValveBankConfig.bValvePosSensorUsed AND NOT (bOpenedPosSensor OR bClosedPosSensor) THEN
	M_DeviceStatus := E_StatusFieldDevice.UNKNOWN; // Valve Position unknown
ELSE
    M_DeviceStatus := E_StatusFieldDevice.OK; // Comm or heartbeat bits maybe binded 
END_IF
</xhtml>
                </ST>
              </body>
              <InterfaceAsPlainText>
                <xhtml xmlns="http://www.w3.org/1999/xhtml">METHOD M_DeviceStatus : E_StatusFieldDevice
VAR
	nStatusFeedback		: DWORD; // Size depends on the hardware config
END_VAR</xhtml>
              </InterfaceAsPlainText>
              <addData />
            </Method>
          </data>
