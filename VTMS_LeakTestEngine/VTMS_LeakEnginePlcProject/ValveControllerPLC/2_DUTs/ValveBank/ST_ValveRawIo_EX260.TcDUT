<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <DUT Name="ST_ValveRawIo_EX260" Id="{7477c171-3d1a-41ee-a249-f531bd2a293e}">
    <Declaration><![CDATA[TYPE ST_ValveRawIo_EX260 : //SEN1 32Ch  valve bank
STRUCT	
   // Each valve bank or IO block RAW IO should be parsed by bytes (8bits) before mapped to these tags in FB_ValveBank
    anInput  AT %I* : ARRAY[0..1] OF SINT; 
	anOutput AT %Q* : ARRAY[0..3] OF SINT;
END_STRUCT
END_TYPE
]]></Declaration>
  </DUT>
</TcPlcObject>