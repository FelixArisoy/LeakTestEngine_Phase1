  <GVL Name="GVL_AteqSpecialCycle" Id="{65e19611-caf8-4f6d-9d4c-942597d29ea0}">
    <Declaration><![CDATA[VAR_GLOBAL
	// Global Constants - ATEQ Special Cycle IDs as Hex WORDs }

    ATR_LearningCycle              	: WORD := 16#0001;
    TestCheckResult                	: WORD := 16#0002;
    AutoTest                       	: WORD := 16#0003;
    CustomUnitLearn                	: WORD := 16#0004;
    CustomUnitCheck                	: WORD := 16#0005;
    ATR_CustomLearn                	: WORD := 16#0006;
    PiezoAutoZeroReg1              	: WORD := 16#0007;
    PiezoAutoZeroReg2              	: WORD := 16#0008; // Used for AutoZero
    Regulator2Adjust               	: WORD := 16#0009;
    RegulatorAdjust                	: WORD := 16#000A;
    InfiniteFill                   	: WORD := 16#000B;
    VolumeComp                     	: WORD := 16#000C;
    AutoVolume                     	: WORD := 16#000D;
    Unused_14                      	: WORD := 16#000E;
    Unused_15                      	: WORD := 16#000F;
    SdPrtPassLearn                 	: WORD := 16#0010;
    SdPrtFailLearn                 	: WORD := 16#0011;
    DirectPressureCheck            	: WORD := 16#0012;
    LeakSensorCheck                	: WORD := 16#0013;
    Reserved_20                    	: WORD := 16#0014;
    Reserved_21                    	: WORD := 16#0015;
    Reserved_22                    	: WORD := 16#0016;
    Unused_23 						: WORD := 16#0017;
    Reserved_24                    	: WORD := 16#0018;
    LinePressureSensorCheck        	: WORD := 16#0019;
    NoSpecial_26                   	: WORD := 16#001A;
    Reserved_27                    	: WORD := 16#001B;
    Reserved_28                    	: WORD := 16#001C;
    TemperatureCheck               	: WORD := 16#001D;
    AtmosphericPressureCheck       	: WORD := 16#001E;
    NoSpecial_31                   	: WORD := 16#001F;

END_VAR]]></Declaration>
  </GVL>
</TcPlcObject>